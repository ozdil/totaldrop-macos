    "sendEmptyHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أضف الملفات التي تريد إرسالها. يحصل المستلم على هذه الملفات فقط، ولا شيء غيرها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "যে ফাইলগুলো পাঠাতে চান সেগুলো যোগ করুন। প্রাপক ঠিক এগুলোই পাবেন, আর কিছু নয়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Přidejte soubory, které chcete odeslat. Příjemce dostane přesně tyto a nic jiného."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tilføj de filer, du vil sende. Modtageren får præcis dem og intet andet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fügen Sie die Dateien hinzu, die Sie senden möchten. Der Empfänger erhält genau diese, sonst nichts."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Προσθέστε τα αρχεία που θέλετε να στείλετε. Ο παραλήπτης λαμβάνει ακριβώς αυτά, τίποτε άλλο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the files you want to send. The receiver gets exactly these, nothing else."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Añade los archivos que quieres enviar. El destinatario recibe exactamente estos, nada más."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "فایل‌هایی را که می‌خواهید بفرستید اضافه کنید. گیرنده دقیقا همین‌ها را دریافت می‌کند، نه چیز دیگری."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lisää tiedostot, jotka haluat lähettää. Vastaanottaja saa juuri nämä, ei mitään muuta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ajoutez les fichiers à envoyer. Le destinataire reçoit exactement ceux-ci, rien d'autre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "יש להוסיף את הקבצים שברצונך לשלוח. הנמען יקבל בדיוק אותם, ושום דבר אחר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "वे फ़ाइलें जोड़ें जिन्हें आप भेजना चाहते हैं। पाने वाले को ठीक यही मिलेंगी, इसके अलावा कुछ नहीं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Add hozzá a küldendő fájlokat. A címzett pontosan ezeket kapja meg, mást nem."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tambahkan file yang ingin Anda kirim. Penerima hanya mendapat file ini, tidak ada yang lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
