    "sendWaitingAccept": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تحقق من الكلمات، ثم انتظر حتى يقبل المستلم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "শব্দগুলো মিলিয়ে দেখুন, তারপর প্রাপকের গ্রহণ করার জন্য অপেক্ষা করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zkontrolujte slova a počkejte, až příjemce soubory přijme."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tjek ordene, og vent så på, at modtageren accepterer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prüfen Sie die Wörter und warten Sie, bis der Empfänger annimmt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ελέγξτε τις λέξεις και περιμένετε να αποδεχτεί ο παραλήπτης."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the words, then wait for the receiver to accept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Comprueba las palabras y espera a que el destinatario acepte."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "کلمات را بررسی کنید، سپس منتظر بمانید تا گیرنده بپذیرد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tarkista sanat ja odota, että vastaanottaja hyväksyy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vérifiez les mots, puis attendez que le destinataire accepte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "יש לבדוק את המילים, ואז להמתין שהנמען יאשר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "शब्द जाँचें, फिर पाने वाले के स्वीकार करने का इंतज़ार करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ellenőrizd a szavakat, aztán várd meg, hogy a címzett elfogadja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Periksa kata-katanya, lalu tunggu penerima menerima."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Controlla le parole, poi attendi che il destinatario accetti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "単語を確認してから、受信者が受け取るのを待ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "단어를 확인한 다음 받는 사람이 수락할 때까지 기다리세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Semak perkataan, kemudian tunggu penerima menerimanya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sjekk ordene, og vent deretter på at mottakeren godtar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Controleer de woorden en wacht tot de ontvanger accepteert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sprawdź słowa, a potem poczekaj, aż odbiorca zaakceptuje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
