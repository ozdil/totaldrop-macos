    "errorTextDamaged": {
      "comment": "Receive result: the text failed its integrity check or is not valid text, so it is not shown",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لم يصل النص كاملًا، لذلك لا يُعرض."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "লেখাটি সম্পূর্ণ অবস্থায় পৌঁছায়নি, তাই দেখানো হচ্ছে না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Text nedorazil v pořádku, proto se nezobrazí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Teksten kom ikke frem i god behold, så den vises ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Text ist nicht unversehrt angekommen und wird deshalb nicht angezeigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Το κείμενο δεν έφτασε ακέραιο, γι’ αυτό δεν εμφανίζεται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The text did not arrive intact, so it is not shown."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El texto no ha llegado íntegro, así que no se muestra."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "متن سالم نرسید، برای همین نمایش داده نمی‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Teksti ei saapunut ehjänä, joten sitä ei näytetä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le texte n’est pas arrivé intact, il n’est donc pas affiché."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הטקסט לא הגיע בשלמותו, ולכן אינו מוצג."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "टेक्स्ट पूरा नहीं पहुँचा, इसलिए दिखाया नहीं जा रहा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A szöveg nem érkezett meg hiánytalanul, ezért nem jelenik meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Teks tidak tiba dengan utuh, jadi tidak ditampilkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il testo non è arrivato integro, quindi non viene mostrato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "テキストが欠けることなく届かなかったため、表示しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "텍스트가 손상 없이 도착하지 않아 표시하지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Teks tidak tiba dengan lengkap, jadi ia tidak dipaparkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Teksten kom ikke fram uskadd, så den vises ikke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De tekst is niet ongeschonden aangekomen en wordt daarom niet getoond."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tekst nie dotarł w całości, dlatego nie jest wyświetlany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O texto não chegou íntegro, por isso não é exibido."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O texto não chegou íntegro, por isso não é mostrado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Textul nu a ajuns întreg, așa că nu este afișat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Текст дошёл не целым, поэтому он не показан."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Texten kom inte fram oskadd, så den visas inte."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Maandishi hayakufika yakiwa kamili, kwa hiyo hayaonyeshwi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ข้อความมาไม่ครบถ้วน จึงไม่แสดง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
