        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "다른 기기로 파일을 바로 보내세요. 종단 간 암호화"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hantar fail terus ke peranti lain, disulitkan hujung ke hujung"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Send filer rett til en annen enhet, ende-til-ende-kryptert"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stuur bestanden rechtstreeks naar een ander apparaat, end-to-end versleuteld"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wysyłaj pliki prosto na inne urządzenie, z szyfrowaniem end-to-end"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Envie arquivos direto para outro dispositivo, com criptografia de ponta a ponta"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Envie ficheiros diretamente para outro dispositivo, com encriptação ponto a ponto"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
