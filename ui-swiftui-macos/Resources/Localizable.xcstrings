    "shareBusy": {
      "comment": "Android: shown when files are shared to TotalDrop while a send or receive is still running; the shared files are not added",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يزال هناك نقل جارٍ. انتظر حتى ينتهي أو أوقفه، ثم شارك مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "একটি স্থানান্তর এখনও চলছে। শেষ হওয়া পর্যন্ত অপেক্ষা করুন বা থামান, তারপর আবার শেয়ার করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Přenos stále probíhá. Počkejte, až skončí, nebo ho zastavte, a pak sdílejte znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En overførsel kører stadig. Vent, til den er færdig, eller stop den, og del så igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eine Übertragung läuft noch. Warte, bis sie fertig ist, oder stoppe sie, und teile dann erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Μια μεταφορά είναι ακόμη σε εξέλιξη. Περιμένετε να τελειώσει ή σταματήστε την και μοιραστείτε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A transfer is still running. Wait for it to finish or stop it, then share again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Todavía hay una transferencia en curso. Espera a que termine o detenla y vuelve a compartir."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "یک انتقال هنوز در جریان است. صبر کنید تمام شود یا آن را متوقف کنید، سپس دوباره هم‌رسانی کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Siirto on yhä käynnissä. Odota, että se valmistuu, tai pysäytä se ja jaa sitten uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un transfert est encore en cours. Attendez qu’il se termine ou arrêtez-le, puis partagez à nouveau."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "העברה עדיין מתבצעת. המתינו לסיומה או עצרו אותה, ואז שתפו שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "एक ट्रांसफ़र अभी चल रहा है। उसके पूरा होने का इंतज़ार करें या उसे रोकें, फिर दोबारा शेयर करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Még folyamatban van egy átvitel. Várd meg, amíg befejeződik, vagy állítsd le, aztán oszd meg újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Masih ada transfer yang berjalan. Tunggu sampai selesai atau hentikan, lalu bagikan lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un trasferimento è ancora in corso. Attendi che finisca o interrompilo, poi condividi di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "転送がまだ進行中です。完了を待つか停止してから、もう一度共有してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "아직 전송이 진행 중입니다. 끝날 때까지 기다리거나 중지한 다음 다시 공유하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pemindahan masih berjalan. Tunggu sehingga selesai atau hentikannya, kemudian kongsi semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En overføring pågår fortsatt. Vent til den er ferdig eller stopp den, og del på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Er loopt nog een overdracht. Wacht tot die klaar is of stop hem, en deel dan opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przesyłanie wciąż trwa. Poczekaj, aż się skończy, lub je zatrzymaj, a potem udostępnij ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uma transferência ainda está em andamento. Espere terminar ou pare-a e compartilhe de novo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ainda está a decorrer uma transferência. Aguarde que termine ou pare-a e partilhe novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un transfer este încă în desfășurare. Așteaptă să se termine sau oprește-l, apoi partajează din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Передача ещё идёт. Дождитесь её окончания или остановите её, затем поделитесь снова."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En överföring pågår fortfarande. Vänta tills den är klar eller stoppa den och dela sedan igen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uhamishaji bado unaendelea. Subiri umalizike au uusimamishe, kisha shiriki tena."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ยังมีการโอนที่กำลังดำเนินอยู่ รอให้เสร็จหรือหยุดก่อน แล้วแชร์อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir aktarım hâlâ sürüyor. Bitmesini bekleyin ya da durdurun, sonra yeniden paylaşın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Передавання ще триває. Дочекайтеся його завершення або зупиніть його, а потім поділіться знову."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ایک منتقلی ابھی جاری ہے۔ اس کے ختم ہونے کا انتظار کریں یا اسے روکیں، پھر دوبارہ شیئر کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vẫn còn một lần truyền đang chạy. Hãy chờ nó xong hoặc dừng nó, rồi chia sẻ lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "仍有传输正在进行。请等待其完成或将其停止，然后再分享。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "仍有傳輸正在進行。請等待其完成或將其停止，然後再分享。"
          }
        }
      }
    },
