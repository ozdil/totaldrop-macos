    "desktopComment": {
      "comment": "Linux desktop entry: one-line description shown as a tooltip in app menus",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أرسل الملفات مباشرة إلى جهاز آخر، بتشفير تام بين الطرفين"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ফাইল সরাসরি অন্য ডিভাইসে পাঠান, এন্ড-টু-এন্ড এনক্রিপ্টেড"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Posílejte soubory přímo do jiného zařízení, koncově šifrované"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Send filer direkte til en anden enhed, end-to-end-krypteret"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dateien direkt an ein anderes Gerät senden, Ende-zu-Ende-verschlüsselt"
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Στείλτε αρχεία απευθείας σε άλλη συσκευή, με κρυπτογράφηση από άκρο σε άκρο"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send files straight to another device, end-to-end encrypted"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Envía archivos directamente a otro dispositivo, con cifrado de extremo a extremo"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "فایل‌ها را مستقیم به دستگاهی دیگر بفرستید، با رمزگذاری سرتاسری"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lähetä tiedostot suoraan toiseen laitteeseen päästä päähän salattuina"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Envoyez des fichiers directement vers un autre appareil, chiffrés de bout en bout"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "שליחת קבצים ישירות למכשיר אחר, בהצפנה מקצה לקצה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "फ़ाइलें सीधे दूसरे डिवाइस पर भेजें, एंड-टू-एंड एन्क्रिप्टेड"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fájlok küldése közvetlenül egy másik eszközre, végpontok közötti titkosítással"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kirim file langsung ke perangkat lain, terenkripsi end-to-end"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Invia file direttamente a un altro dispositivo, con crittografia end-to-end"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ファイルを別のデバイスへ直接送信。エンドツーエンドで暗号化"
