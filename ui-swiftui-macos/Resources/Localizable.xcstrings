    "sendTextHidden": {
      "comment": "Send screen: the text to send holds invisible control or direction characters; they are sent as they are",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يحتوي النص على أحرف مخفية، مثل علامات الاتجاه. وتُرسل معه أيضًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "লেখায় দিক-চিহ্নের মতো লুকানো অক্ষর আছে। সেগুলোও লেখার সঙ্গে পাঠানো হয়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Text obsahuje skryté znaky, například značky směru. Odešlou se spolu s ním."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Teksten indeholder skjulte tegn, f.eks. retningsmærker. De sendes med."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Text enthält versteckte Zeichen, etwa Richtungszeichen. Sie werden mitgesendet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
