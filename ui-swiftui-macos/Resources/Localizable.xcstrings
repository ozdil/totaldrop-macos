          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "לא ניתן היה להגיע לשרת הממסר או שהוא לא מוגדר, או ששני המכשירים לא משתמשים באותו שרת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "रिले सर्वर तक नहीं पहुँचा जा सका या वह सेट नहीं है, या दोनों डिवाइस एक ही रिले सर्वर इस्तेमाल नहीं करते।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A továbbító szerver nem érhető el vagy nincs beállítva, vagy a két eszköz nem ugyanazt használja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Server relai tidak dapat dijangkau atau belum diatur, atau kedua perangkat tidak memakai server yang sama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il server di inoltro non è raggiungibile o non è configurato, oppure i due dispositivi non usano lo stesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "リレーに接続できないか、リレーが設定されていないか、2台のデバイスが同じリレーを使っていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "릴레이에 연결할 수 없거나 릴레이가 설정되지 않았거나, 두 기기가 같은 릴레이를 쓰지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pelayan geganti tidak dapat dicapai atau belum ditetapkan, atau kedua-dua peranti tidak menggunakan pelayan yang sama."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Reléserveren kunne ikke nås eller er ikke satt opp, eller de to enhetene bruker ikke den samme."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De relayserver was niet bereikbaar of is niet ingesteld, of de twee apparaten gebruiken niet dezelfde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Serwer pośredniczący jest nieosiągalny lub nie został skonfigurowany albo oba urządzenia nie używają tego samego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não foi possível alcançar o servidor de retransmissão ou ele não está configurado, ou os dois dispositivos não usam o mesmo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não foi possível chegar ao servidor de retransmissão ou este não está configurado, ou os dois dispositivos não usam o mesmo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Serverul releu nu a putut fi contactat sau nu este configurat, ori cele două dispozitive nu folosesc același server."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ретранслятор недоступен или не настроен, либо устройства используют разные ретрансляторы."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Reläservern gick inte att nå eller är inte inställd, eller så använder enheterna inte samma reläserver."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seva ya kati haikufikiwa au haijawekwa, au vifaa hivi viwili havitumii seva moja."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เข้าถึงเซิร์ฟเวอร์รีเลย์ไม่ได้หรือยังไม่ได้ตั้งค่า หรืออุปกรณ์ทั้งสองไม่ได้ใช้รีเลย์เดียวกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktarma sunucusuna ulaşılamadı ya da ayarlı değil, veya iki cihaz aynı aktarma sunucusunu kullanmıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ретранслятор недоступний або не налаштований, або пристрої використовують різні ретранслятори."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ریلے تک نہیں پہنچا جا سکا یا وہ سیٹ نہیں ہے، یا دونوں آلات ایک ہی ریلے استعمال نہیں کرتے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không kết nối được tới máy chủ chuyển tiếp hoặc máy chủ chưa được thiết lập, hoặc hai thiết bị không dùng cùng một máy chủ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "无法连接到中继服务器或尚未设置中继服务器，或两台设备使用的不是同一个中继服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "無法連到中繼伺服器或尚未設定中繼伺服器，或兩台裝置使用的不是同一個中繼伺服器。"
          }
        }
      }
    },
    "causeTimedOut": {
      "comment": "Under Details of a failed transfer: why it failed. The connection went silent (QUIC idle timeout), or the sender stopped sending.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "توقف الاتصال عن الاستجابة. ربما فقد أحد الجهازين الشبكة أو دخل في وضع السكون."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "সংযোগ সাড়া দেওয়া বন্ধ করেছে। কোনো একটি ডিভাইস হয়তো নেটওয়ার্ক হারিয়েছে বা ঘুমিয়ে পড়েছে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Spojení přestalo odpovídat. Jedno ze zařízení možná ztratilo síť nebo přešlo do režimu spánku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Forbindelsen holdt op med at svare. En af enhederne har måske mistet netværket eller er gået i dvale."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Verbindung reagiert nicht mehr. Eines der Geräte hat vielleicht das Netzwerk verloren oder ist in den Ruhezustand gegangen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Η σύνδεση σταμάτησε να αποκρίνεται. Μία από τις συσκευές ίσως έχασε το δίκτυο ή μπήκε σε αναστολή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection stopped responding. One of the devices may have lost its network or gone to sleep."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La conexión dejó de responder. Puede que uno de los dispositivos haya perdido la red o se haya suspendido."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اتصال دیگر پاسخ نمی‌دهد. شاید یکی از دستگاه‌ها شبکه را از دست داده یا به حالت خواب رفته باشد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yhteys lakkasi vastaamasta. Toinen laitteista on ehkä menettänyt verkon tai mennyt lepotilaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La connexion ne répond plus. L'un des appareils a peut-être perdu le réseau ou s'est mis en veille."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "החיבור הפסיק להגיב. ייתכן שאחד המכשירים איבד את הרשת או נכנס למצב שינה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कनेक्शन ने जवाब देना बंद कर दिया। हो सकता है किसी डिवाइस का नेटवर्क चला गया हो या वह स्लीप में चला गया हो।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A kapcsolat nem válaszol. Az egyik eszköz talán elvesztette a hálózatot vagy alvó módba lépett."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Koneksi berhenti merespons. Salah satu perangkat mungkin kehilangan jaringan atau masuk mode tidur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La connessione ha smesso di rispondere. Uno dei dispositivi potrebbe aver perso la rete o essere andato in sospensione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "接続が応答しなくなりました。どちらかのデバイスがネットワークから切断されたか、スリープした可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "연결이 응답하지 않습니다. 기기 중 하나의 네트워크가 끊겼거나 절전 모드로 전환되었을 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sambungan berhenti memberi respons. Salah satu peranti mungkin kehilangan rangkaian atau masuk mod tidur."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Forbindelsen sluttet å svare. En av enhetene kan ha mistet nettverket eller gått i dvale."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De verbinding reageert niet meer. Een van de apparaten is misschien zijn netwerk kwijt of in slaapstand gegaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Połączenie przestało odpowiadać. Jedno z urządzeń mogło stracić sieć albo przejść w stan uśpienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A conexão parou de responder. Um dos dispositivos pode ter perdido a rede ou entrado em suspensão."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A ligação deixou de responder. Um dos dispositivos pode ter perdido a rede ou entrado em suspensão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Conexiunea nu mai răspunde. Unul dintre dispozitive poate a pierdut rețeaua sau a intrat în repaus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Соединение перестало отвечать. Возможно, одно из устройств потеряло сеть или ушло в спящий режим."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anslutningen slutade svara. En av enheterna kan ha tappat nätverket eller gått i viloläge."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Muunganisho uliacha kujibu. Huenda mojawapo ya vifaa lilipoteza mtandao au lilienda usingizini."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การเชื่อมต่อหยุดตอบสนอง อุปกรณ์เครื่องหนึ่งอาจขาดการเชื่อมต่อเครือข่ายหรือเข้าสู่โหมดสลีป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı artık yanıt vermiyor. Cihazlardan biri ağ bağlantısını kaybetmiş ya da uykuya geçmiş olabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "З'єднання перестало відповідати. Можливо, один із пристроїв втратив мережу або перейшов у режим сну."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "کنکشن نے جواب دینا بند کر دیا۔ ہو سکتا ہے کسی آلے کا نیٹ ورک چلا گیا ہو یا وہ سلیپ میں چلا گیا ہو۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kết nối ngừng phản hồi. Một trong hai thiết bị có thể đã mất mạng hoặc chuyển sang chế độ ngủ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "连接已停止响应。其中一台设备可能断开了网络或进入了睡眠。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "連線已停止回應。其中一台裝置可能中斷了網路或進入了睡眠。"
          }
        }
      }
    },
