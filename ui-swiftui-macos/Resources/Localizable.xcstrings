    "draftTranslation": {
      "comment": "Shown in Settings when some of the text in this language is an unreviewed draft",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "هذه الترجمة قيد المراجعة. ساعد في تحسينها على GitHub."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এই অনুবাদটি পর্যালোচনা করা হচ্ছে। GitHub-এ এটি আরও ভালো করতে সাহায্য করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tento překlad se kontroluje. Pomozte ho vylepšit na GitHubu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne oversættelse er ved at blive gennemgået. Hjælp med at forbedre den på GitHub."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diese Übersetzung wird noch geprüft. Helfen Sie auf GitHub, sie zu verbessern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Αυτή η μετάφραση βρίσκεται υπό έλεγχο. Βοηθήστε να βελτιωθεί στο GitHub."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This translation is being reviewed. Help improve it on GitHub."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta traducción se está revisando. Ayuda a mejorarla en GitHub."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "این ترجمه در حال بازبینی است. در GitHub به بهتر شدن آن کمک کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tätä käännöstä tarkistetaan. Auta parantamaan sitä GitHubissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cette traduction est en cours de relecture. Aidez à l'améliorer sur GitHub."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "התרגום הזה נמצא בבדיקה. אפשר לעזור לשפר אותו ב־GitHub."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इस अनुवाद की समीक्षा हो रही है। GitHub पर इसे बेहतर बनाने में मदद करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ez a fordítás ellenőrzés alatt áll. Segíts javítani a GitHubon."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terjemahan ini sedang ditinjau. Bantu perbaiki di GitHub."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questa traduzione è in fase di revisione. Aiuta a migliorarla su GitHub."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この翻訳はレビュー中です。GitHub で改善にご協力ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 번역은 검토 중입니다. GitHub에서 개선을 도와주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terjemahan ini sedang disemak. Bantu memperbaikinya di GitHub."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne oversettelsen blir gjennomgått. Hjelp til med å forbedre den på GitHub."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deze vertaling wordt nagekeken. Help haar te verbeteren op GitHub."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "To tłumaczenie jest w trakcie sprawdzania. Pomóż je ulepszyć na GitHubie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta tradução está em revisão. Ajude a melhorá-la no GitHub."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta tradução está em revisão. Ajude a melhorá-la no GitHub."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Această traducere este în curs de revizuire. Ajutați la îmbunătățirea ei pe GitHub."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Этот перевод проверяется. Помогите улучшить его на GitHub."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Den här översättningen granskas. Hjälp till att förbättra den på GitHub."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tafsiri hii inakaguliwa. Saidia kuiboresha kwenye GitHub."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "คำแปลนี้อยู่ระหว่างการตรวจทาน ช่วยปรับปรุงได้ที่ GitHub"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu çeviri gözden geçiriliyor. GitHub'da iyileştirmeye yardım edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Цей переклад перевіряється. Допоможіть покращити його на GitHub."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اس ترجمے کا جائزہ لیا جا رہا ہے۔ GitHub پر اسے بہتر بنانے میں مدد کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bản dịch này đang được xem xét. Hãy giúp cải thiện trên GitHub."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此翻译正在审核中。欢迎在 GitHub 上帮助改进。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "這份翻譯正在審閱中。歡迎到 GitHub 協助改進。"
          }
        }
      }
