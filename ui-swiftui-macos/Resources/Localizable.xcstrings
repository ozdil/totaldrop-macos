    "settingsAboutBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop مجاني ومفتوح المصدر، ويُموَّل بالتبرعات. مرخّص بموجب GPL-3.0-or-later."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop বিনামূল্যে ও ওপেন সোর্স, অনুদানে চলে। লাইসেন্স GPL-3.0-or-later।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop je zdarma a má otevřený zdrojový kód, financují ho dary. Licence GPL-3.0-or-later."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop er gratis og open source og finansieres af donationer. Licens: GPL-3.0-or-later."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop ist kostenlos und quelloffen und wird durch Spenden finanziert. Lizenz: GPL-3.0-or-later."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Το TotalDrop είναι δωρεάν και ανοιχτού κώδικα, με χρηματοδότηση από δωρεές. Άδεια: GPL-3.0-or-later."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TotalDrop is free and open source, funded by donations. Licensed GPL-3.0-or-later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop es gratuito y de código abierto, financiado con donaciones. Licencia GPL-3.0-or-later."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop رایگان و متن‌باز است و با کمک‌های مالی اداره می‌شود. مجوز GPL-3.0-or-later."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop on ilmainen ja avointa lähdekoodia, ja se rahoitetaan lahjoituksilla. Lisenssi: GPL-3.0-or-later."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop est gratuit et open source, financé par des dons. Sous licence GPL-3.0-or-later."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop חינמי וקוד פתוח, וממומן מתרומות. ברישיון GPL-3.0-or-later."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop मुफ़्त और ओपन सोर्स है, दान से चलता है। लाइसेंस GPL-3.0-or-later।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A TotalDrop ingyenes és nyílt forráskódú, adományokból működik. Licenc: GPL-3.0-or-later."
          }
        },
        "id": {
          "stringUnit": {
