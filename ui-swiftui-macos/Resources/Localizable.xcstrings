    "causeRelay": {
      "comment": "Under Details of a failed transfer: why it failed, in plain words",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعذر الوصول إلى خادم الترحيل أو أنه غير مُعدّ، أو أن الجهازين لا يستخدمان الخادم نفسه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "রিলে সার্ভারে পৌঁছানো যায়নি বা সেটি সেট করা নেই, অথবা দুটি ডিভাইস একই রিলে সার্ভার ব্যবহার করছে না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zprostředkující server není dostupný nebo není nastaven, případně obě zařízení nepoužívají tentýž."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Relæserveren kunne ikke nås eller er ikke sat op, eller de to enheder bruger ikke den samme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Relay-Server war nicht erreichbar oder ist nicht eingerichtet, oder die beiden Geräte nutzen nicht denselben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ο διακομιστής αναμετάδοσης δεν ήταν προσβάσιμος ή δεν έχει ρυθμιστεί, ή οι δύο συσκευές δεν χρησιμοποιούν τον ίδιο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The relay server could not be reached or is not set up, or the two devices do not use the same one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se pudo llegar al servidor de retransmisión o no está configurado, o los dos dispositivos no usan el mismo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "دسترسی به سرور رله ممکن نشد یا سرور رله تنظیم نشده است، یا دو دستگاه از یک سرور رله استفاده نمی‌کنند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Välityspalvelinta ei tavoitettu tai sitä ei ole määritetty, tai laitteet eivät käytä samaa välityspalvelinta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
