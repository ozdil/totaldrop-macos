    "sameNetworkNote": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يعمل عبر الإنترنت. عندما يتعذر على الجهازين الوصول أحدهما إلى الآخر مباشرة، يمر النقل المشفّر عبر خادم الترحيل، الذي لا يستطيع قراءته."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ইন্টারনেটের মাধ্যমে কাজ করে। ডিভাইসগুলো সরাসরি একে অপরের কাছে পৌঁছাতে না পারলে এনক্রিপ্ট করা ট্রান্সফার রিলে সার্ভারের মধ্য দিয়ে যায়, যা এটি পড়তে পারে না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Funguje přes internet. Když se zařízení nemohou spojit přímo, šifrovaný přenos jde přes zprostředkující server, který ho nemůže přečíst."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Virker over internettet. Når enhederne ikke kan nå hinanden direkte, går den krypterede overførsel gennem relæserveren, som ikke kan læse den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Funktioniert über das Internet. Wenn die Geräte einander nicht direkt erreichen, läuft die verschlüsselte Übertragung über den Relay-Server, der sie nicht lesen kann."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Λειτουργεί μέσω διαδικτύου. Όταν οι συσκευές δεν μπορούν να συνδεθούν απευθείας, η κρυπτογραφημένη μεταφορά περνά από τον διακομιστή αναμετάδοσης, που δεν μπορεί να τη διαβάσει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Works across the internet. When the devices cannot reach each other directly, the encrypted transfer goes through the relay, which cannot read it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Funciona a través de internet. Cuando los dispositivos no pueden conectarse directamente, la transferencia cifrada pasa por el servidor de retransmisión, que no puede leerla."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "از طریق اینترنت کار می‌کند. وقتی دستگاه‌ها نتوانند مستقیما به هم برسند، انتقال رمزگذاری‌شده از سرور رله می‌گذرد که نمی‌تواند آن را بخواند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toimii internetin yli. Kun laitteet eivät tavoita toisiaan suoraan, salattu siirto kulkee välityspalvelimen kautta, joka ei voi lukea sitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fonctionne via Internet. Quand les appareils ne peuvent pas se joindre directement, le transfert chiffré passe par le serveur relais, qui ne peut pas le lire."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "עובד דרך האינטרנט. כשהמכשירים לא יכולים להגיע זה לזה ישירות, ההעברה המוצפנת עוברת דרך שרת הממסר, שאינו יכול לקרוא אותה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इंटरनेट पर काम करता है। जब डिवाइस सीधे एक-दूसरे तक नहीं पहुँच पाते, तो एन्क्रिप्टेड ट्रांसफ़र रिले सर्वर से होकर जाता है, जो उसे पढ़ नहीं सकता।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Az interneten keresztül működik. Ha az eszközök nem érik el egymást közvetlenül, a titkosított átvitel a továbbító szerveren megy át, amely nem tudja elolvasni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Berfungsi melalui internet. Jika perangkat tidak dapat saling terhubung langsung, transfer terenkripsi melewati server relai, yang tidak dapat membacanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Funziona via internet. Quando i dispositivi non riescono a raggiungersi direttamente, il trasferimento crittografato passa dal server di inoltro, che non può leggerlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "インターネット経由で使えます。デバイス同士が直接つながらない場合、暗号化された転送はリレーを経由します。リレーは内容を読めません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "인터넷을 통해 작동합니다. 기기끼리 직접 연결할 수 없으면 암호화된 전송은 릴레이를 거치며, 릴레이는 내용을 읽을 수 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Berfungsi melalui internet. Apabila peranti tidak dapat berhubung secara terus, pemindahan yang disulitkan melalui pelayan geganti, yang tidak dapat membacanya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fungerer over internett. Når enhetene ikke når hverandre direkte, går den krypterte overføringen gjennom reléserveren, som ikke kan lese den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Werkt via het internet. Als de apparaten elkaar niet rechtstreeks kunnen bereiken, gaat de versleutelde overdracht via de relayserver, die haar niet kan lezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Działa przez internet. Gdy urządzenia nie mogą połączyć się bezpośrednio, zaszyfrowany transfer przechodzi przez serwer pośredniczący, który nie może go odczytać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Funciona pela internet. Quando os dispositivos não conseguem se alcançar diretamente, a transferência criptografada passa pelo servidor de retransmissão, que não consegue lê-la."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Funciona através da Internet. Quando os dispositivos não conseguem comunicar diretamente, a transferência encriptada passa pelo servidor de retransmissão, que não a consegue ler."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Funcționează prin internet. Când dispozitivele nu se pot conecta direct, transferul criptat trece prin serverul releu, care nu îl poate citi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Работает через интернет. Если устройства не могут связаться напрямую, зашифрованная передача идёт через ретранслятор, который не может её прочитать."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fungerar över internet. När enheterna inte når varandra direkt går den krypterade överföringen via reläservern, som inte kan läsa den."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inafanya kazi kupitia intaneti. Vifaa visipoweza kufikiana moja kwa moja, uhamishaji uliosimbwa fiche hupita kupitia seva ya kati, ambayo haiwezi kuusoma."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ทำงานผ่านอินเทอร์เน็ต เมื่ออุปกรณ์เชื่อมต่อกันโดยตรงไม่ได้ การโอนที่เข้ารหัสจะผ่านเซิร์ฟเวอร์รีเลย์ ซึ่งอ่านข้อมูลนั้นไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İnternet üzerinden çalışır. Cihazlar birbirine doğrudan ulaşamazsa şifreli aktarım, içeriği okuyamayan aktarma sunucusundan geçer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Працює через інтернет. Якщо пристрої не можуть з'єднатися напряму, зашифрована передача йде через ретранслятор, який не може її прочитати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "انٹرنیٹ پر کام کرتا ہے۔ جب آلات ایک دوسرے تک براہ راست نہ پہنچ سکیں تو انکرپٹڈ منتقلی ریلے سے گزرتی ہے، جو اسے پڑھ نہیں سکتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hoạt động qua internet. Khi các thiết bị không thể kết nối trực tiếp với nhau, dữ liệu truyền đã mã hóa sẽ đi qua máy chủ chuyển tiếp, nơi không thể đọc được nội dung."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "可通过互联网使用。设备之间无法直接连接时，加密传输会经过中继服务器，中继服务器无法读取内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "可透過網際網路使用。裝置之間無法直接連線時，加密傳輸會經過中繼伺服器，中繼伺服器無法讀取內容。"
          }
        }
      }
    },
    "sendAddFailed": {
      "comment": "Shown on the send screen when the system file picker could not hand over the chosen files (a path it cannot read, too little memory, or no space left for its copy).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعذّرت إضافة الملفات. حاول مرة أخرى. إذا تكرر ذلك، فتأكد من وجود مساحة فارغة كافية على هذا الجهاز، أو اختر الملفات من مكان آخر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ফাইলগুলো যোগ করা যায়নি। আবার চেষ্টা করুন। আবারও এমন হলে দেখুন এই ডিভাইসে যথেষ্ট খালি জায়গা আছে কি না, অথবা অন্য কোনো জায়গা থেকে ফাইলগুলো বেছে নিন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Soubory se nepodařilo přidat. Zkuste to znovu. Pokud se to stane znovu, zkontrolujte, zda je v tomto zařízení dost volného místa, nebo vyberte soubory z jiného místa."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Filerne kunne ikke tilføjes. Prøv igen. Hvis det sker igen, så tjek, at der er nok ledig plads på denne enhed, eller vælg filerne et andet sted fra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Dateien konnten nicht hinzugefügt werden. Versuchen Sie es erneut. Wenn es wieder passiert, prüfen Sie, ob auf diesem Gerät genügend Speicherplatz frei ist, oder wählen Sie die Dateien an einem anderen Ort aus."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Δεν ήταν δυνατή η προσθήκη των αρχείων. Δοκιμάστε ξανά. Αν συμβεί πάλι, ελέγξτε ότι υπάρχει αρκετός ελεύθερος χώρος σε αυτή τη συσκευή ή επιλέξτε τα αρχεία από άλλη τοποθεσία."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The files could not be added. Try again. If it happens again, check that this device has enough free space, or choose the files from another place."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se pudieron añadir los archivos. Vuelve a intentarlo. Si vuelve a pasar, comprueba que haya suficiente espacio libre en este dispositivo o elige los archivos desde otro lugar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "افزودن فایل‌ها ممکن نشد. دوباره امتحان کنید. اگر باز هم پیش آمد، بررسی کنید که روی این دستگاه فضای خالی کافی هست، یا فایل‌ها را از جای دیگری انتخاب کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tiedostoja ei voitu lisätä. Yritä uudelleen. Jos näin käy taas, tarkista, että tällä laitteella on tarpeeksi vapaata tilaa, tai valitse tiedostot toisesta paikasta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossible d'ajouter les fichiers. Réessayez. Si cela se reproduit, vérifiez qu'il reste assez d'espace libre sur cet appareil, ou choisissez les fichiers à un autre emplacement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "לא ניתן היה להוסיף את הקבצים. יש לנסות שוב. אם זה קורה שוב, יש לוודא שיש מספיק מקום פנוי במכשיר הזה, או לבחור את הקבצים ממקום אחר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "फ़ाइलें जोड़ी नहीं जा सकीं। दोबारा कोशिश करें। अगर फिर से ऐसा हो, तो देखें कि इस डिवाइस पर पर्याप्त खाली जगह है, या फ़ाइलें किसी दूसरी जगह से चुनें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A fájlokat nem sikerült hozzáadni. Próbáld újra. Ha ismét előfordul, ellenőrizd, hogy van-e elég szabad hely ezen az eszközön, vagy válaszd ki a fájlokat máshonnan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "File tidak dapat ditambahkan. Coba lagi. Jika terjadi lagi, pastikan ruang kosong di perangkat ini cukup, atau pilih file dari tempat lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossibile aggiungere i file. Riprova. Se succede di nuovo, controlla che su questo dispositivo ci sia abbastanza spazio libero, oppure scegli i file da un'altra posizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ファイルを追加できませんでした。もう一度お試しください。それでも追加できない場合は、このデバイスに十分な空き容量があるかを確かめるか、別の場所からファイルを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "파일을 추가하지 못했습니다. 다시 시도하세요. 또 그러면 이 기기에 여유 공간이 충분한지 확인하거나 다른 위치에서 파일을 선택하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fail tidak dapat ditambah. Cuba lagi. Jika berlaku lagi, pastikan ruang kosong pada peranti ini mencukupi, atau pilih fail dari tempat lain."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Filene kunne ikke legges til. Prøv igjen. Hvis det skjer igjen, sjekk at det er nok ledig plass på denne enheten, eller velg filene fra et annet sted."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De bestanden konden niet worden toegevoegd. Probeer het opnieuw. Gebeurt het weer, controleer dan of er genoeg vrije ruimte op dit apparaat is, of kies de bestanden op een andere plek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie udało się dodać plików. Spróbuj ponownie. Jeśli to się powtórzy, sprawdź, czy na tym urządzeniu jest dość wolnego miejsca, albo wybierz pliki z innego miejsca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não foi possível adicionar os arquivos. Tente novamente. Se acontecer de novo, verifique se há espaço livre suficiente neste dispositivo ou escolha os arquivos em outro lugar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não foi possível adicionar os ficheiros. Tente novamente. Se voltar a acontecer, verifique se há espaço livre suficiente neste dispositivo ou escolha os ficheiros noutro local."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fișierele nu au putut fi adăugate. Încercați din nou. Dacă se întâmplă iar, verificați dacă pe acest dispozitiv este destul spațiu liber sau alegeți fișierele din alt loc."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не удалось добавить файлы. Попробуйте ещё раз. Если это повторится, проверьте, достаточно ли свободного места на этом устройстве, или выберите файлы в другом месте."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Filerna kunde inte läggas till. Försök igen. Om det händer igen, kontrollera att det finns tillräckligt med ledigt utrymme på den här enheten, eller välj filerna från en annan plats."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Faili hazikuweza kuongezwa. Jaribu tena. Ikitokea tena, hakikisha kuna nafasi ya kutosha kwenye kifaa hiki, au uchague faili kutoka mahali pengine."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เพิ่มไฟล์ไม่ได้ โปรดลองอีกครั้ง หากยังเกิดขึ้นอีก ให้ตรวจสอบว่าอุปกรณ์นี้มีพื้นที่ว่างเพียงพอ หรือเลือกไฟล์จากที่อื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyalar eklenemedi. Yeniden deneyin. Yine olursa bu cihazda yeterli boş alan olduğuna bakın ya da dosyaları başka bir yerden seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не вдалося додати файли. Спробуйте ще раз. Якщо це повториться, перевірте, чи достатньо вільного місця на цьому пристрої, або виберіть файли в іншому місці."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "فائلیں شامل نہیں ہو سکیں۔ دوبارہ کوشش کریں۔ اگر پھر ایسا ہو تو دیکھیں کہ اس ڈیوائس پر کافی خالی جگہ ہے، یا فائلیں کسی اور جگہ سے منتخب کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không thể thêm tệp. Hãy thử lại. Nếu vẫn xảy ra, hãy kiểm tra xem thiết bị này còn đủ dung lượng trống, hoặc chọn tệp từ nơi khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "无法添加文件。请重试。如果仍然出现这种情况，请确认此设备有足够的可用空间，或从其他位置选择文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "無法新增檔案。請再試一次。如果仍然發生，請確認這部裝置有足夠的可用空間，或從其他位置選擇檔案。"
          }
        }
      }
    },
