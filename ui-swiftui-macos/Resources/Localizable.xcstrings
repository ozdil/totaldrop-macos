          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Текст надійшов не цілим, тому його не показано."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "متن مکمل نہیں پہنچا، اس لیے نہیں دکھایا جا رہا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Văn bản không đến nguyên vẹn nên không được hiển thị."
