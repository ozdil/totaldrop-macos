    "errorCodeExpired": {
      "comment": "Shown to the sender: nobody came for the code before the server let it expire (15 minutes). Same text as cliErrCodeExpired",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "انتهت صلاحية الرمز قبل أن يستخدمه أحد. أرسل مرة أخرى للحصول على رمز جديد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "কেউ ব্যবহার করার আগেই কোডটির মেয়াদ শেষ হয়ে গেছে। নতুন কোড পেতে আবার পাঠান।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kód vypršel dřív, než ho někdo použil. Pro nový kód odešlete soubory znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Koden udløb, før nogen brugte den. Send igen for at få en ny kode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Code ist abgelaufen, bevor ihn jemand verwendet hat. Senden Sie erneut, um einen neuen Code zu erhalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ο κωδικός έληξε πριν τον χρησιμοποιήσει κάποιος. Στείλτε ξανά για να πάρετε νέο κωδικό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody used the code before it expired. Send again to get a new code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El código caducó antes de que alguien lo usara. Vuelve a enviar para obtener un código nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "کد پیش از آنکه کسی از آن استفاده کند منقضی شد. برای گرفتن کد جدید دوباره ارسال کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Koodi vanheni ennen kuin kukaan käytti sitä. Lähetä uudelleen saadaksesi uuden koodin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le code a expiré avant que quelqu'un ne l'utilise. Envoyez à nouveau pour obtenir un nouveau code."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "תוקף הקוד פג לפני שמישהו השתמש בו. יש לשלוח שוב כדי לקבל קוד חדש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "किसी के इस्तेमाल करने से पहले ही कोड की अवधि खत्म हो गई। नया कोड पाने के लिए फिर से भेजें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A kód lejárt, mielőtt bárki használta volna. Küldd el újra, hogy új kódot kapj."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kode kedaluwarsa sebelum ada yang memakainya. Kirim lagi untuk mendapatkan kode baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il codice è scaduto prima che qualcuno lo usasse. Invia di nuovo per ottenere un nuovo codice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "誰にも使われないまま、コードの有効期限が切れました。もう一度送信すると新しいコードが発行されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "아무도 사용하지 않은 채 코드가 만료되었습니다. 새 코드를 받으려면 다시 보내세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kod tamat tempoh sebelum sesiapa menggunakannya. Hantar semula untuk mendapatkan kod baharu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Koden utløp før noen brukte den. Send på nytt for å få en ny kode."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De code is verlopen voordat iemand hem gebruikte. Verstuur opnieuw voor een nieuwe code."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kod wygasł, zanim ktokolwiek go użył. Wyślij ponownie, aby dostać nowy kod."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O código expirou antes que alguém o usasse. Envie de novo para receber um código novo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O código expirou antes de alguém o usar. Envie de novo para obter um código novo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Codul a expirat înainte să îl folosească cineva. Trimiteți din nou pentru a primi un cod nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Срок действия кода истёк, а им так никто и не воспользовался. Отправьте ещё раз, чтобы получить новый код."
          }
        },
        "sv": {
          "stringUnit": {
