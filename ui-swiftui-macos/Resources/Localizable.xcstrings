        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "অন্য ডিভাইসের সঙ্গে সংযোগ করা যায়নি। দুটি ডিভাইসই অনলাইনে আছে কিনা দেখে আবার চেষ্টা করুন।"
