    "causeProtocol": {
      "comment": "Under Details of a failed transfer: why it failed, in plain words",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أرسل الجهاز الآخر شيئًا لا يفهمه هذا الإصدار. قد يساعد تحديث TotalDrop على الجهازين."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "অন্য ডিভাইস এমন কিছু পাঠিয়েছে যা এই সংস্করণ বোঝে না। দুটি ডিভাইসেই TotalDrop আপডেট করলে সাহায্য হতে পারে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Druhé zařízení poslalo něco, čemu tato verze nerozumí. Pomoci může aktualizace TotalDrop na obou zařízeních."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Den anden enhed sendte noget, som denne version ikke forstår. Det kan hjælpe at opdatere TotalDrop på begge enheder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das andere Gerät hat etwas gesendet, das diese Version nicht versteht. Ein Update von TotalDrop auf beiden Geräten kann helfen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Η άλλη συσκευή έστειλε κάτι που αυτή η έκδοση δεν καταλαβαίνει. Μπορεί να βοηθήσει η ενημέρωση του TotalDrop και στις δύο συσκευές."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The other device sent something this version does not understand. Updating TotalDrop on both devices may help."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El otro dispositivo envió algo que esta versión no entiende. Actualizar TotalDrop en ambos dispositivos puede ayudar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "دستگاه دیگر چیزی فرستاد که این نسخه آن را نمی‌فهمد. به‌روزرسانی TotalDrop در هر دو دستگاه ممکن است کمک کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toinen laite lähetti jotain, mitä tämä versio ei ymmärrä. TotalDropin päivittäminen molemmissa laitteissa voi auttaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
