    "receiveCodeInvalid": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يبدو هذا رمزًا. يبدأ الرمز برقم، تليه كلمتان أو ثلاث كلمات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এটি কোডের মতো দেখাচ্ছে না। কোড একটি সংখ্যা দিয়ে শুরু হয়, তারপর দুটি বা তিনটি শব্দ থাকে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tohle nevypadá jako kód. Kód začíná číslem, za kterým následují dvě nebo tři slova."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Det ligner ikke en kode. Den starter med et tal efterfulgt af to eller tre ord."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das sieht nicht wie ein Code aus. Er beginnt mit einer Zahl, danach folgen zwei oder drei Wörter."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Αυτό δεν μοιάζει με κωδικό. Ξεκινά με έναν αριθμό και ακολουθούν δύο ή τρεις λέξεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That does not look like a code. It starts with a number, then two or three words."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eso no parece un código. Empieza con un número, seguido de dos o tres palabras."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "این شبیه کد نیست. کد با یک عدد شروع می‌شود و پس از آن دو یا سه کلمه می‌آید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tämä ei näytä koodilta. Koodi alkaa numerolla, jota seuraa kaksi tai kolme sanaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cela ne ressemble pas à un code. Un code commence par un nombre, suivi de deux ou trois mots."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "זה לא נראה כמו קוד. קוד מתחיל במספר, ואחריו שתיים או שלוש מילים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह कोड जैसा नहीं दिखता। कोड एक संख्या से शुरू होता है, फिर दो या तीन शब्द आते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ez nem tűnik kódnak. A kód egy számmal kezdődik, utána két vagy három szó jön."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Itu tidak terlihat seperti kode. Kode diawali angka, lalu dua atau tiga kata."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Non sembra un codice. Inizia con un numero, seguito da due o tre parole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "コードの形式ではありません。コードは数字で始まり、そのあとに2語または3語が続きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "코드 형식이 아닙니다. 코드는 숫자로 시작하고 그 뒤에 단어 두세 개가 옵니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Itu tidak kelihatan seperti kod. Kod bermula dengan nombor, diikuti dua atau tiga perkataan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Det ser ikke ut som en kode. Den starter med et tall, etterfulgt av to eller tre ord."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dat lijkt geen code. Een code begint met een getal, gevolgd door twee of drie woorden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "To nie wygląda na kod. Kod zaczyna się od liczby, po której są dwa lub trzy słowa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Isso não parece um código. Ele começa com um número, seguido de duas ou três palavras."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Isto não parece um código. Começa com um número, seguido de duas ou três palavras."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nu pare a fi un cod. Codul începe cu un număr, urmat de două sau trei cuvinte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Это не похоже на код. Код начинается с числа, за которым идут два или три слова."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Det ser inte ut som en kod. Den börjar med ett tal följt av två eller tre ord."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hii haionekani kama msimbo. Msimbo huanza na nambari, kisha maneno mawili au matatu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ดูไม่เหมือนรหัส รหัสขึ้นต้นด้วยตัวเลข ตามด้วยคำสองหรือสามคำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bir koda benzemiyor. Kod bir sayıyla başlar, ardından iki ya da üç kelime gelir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Це не схоже на код. Код починається з числа, за яким ідуть два або три слова."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "یہ کوڈ نہیں لگتا۔ کوڈ ایک نمبر سے شروع ہوتا ہے، پھر دو یا تین الفاظ آتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đây có vẻ không phải là mã. Mã bắt đầu bằng một số, sau đó là hai hoặc ba từ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "这看起来不像代码。代码以数字开头，后面跟两个或三个单词。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "這看起來不像代碼。代碼以數字開頭，後面接兩個或三個單字。"
          }
        }
      }
    },
