    "metainfoWords": {
      "comment": "Linux software centres: feature list item about the four verification words that show no one is intercepting the transfer",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أربع كلمات تحقق تُظهر أن أحدًا لم يتدخل بينكما"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "যাচাইয়ের চারটি শব্দ দেখায় যে মাঝখানে কেউ নেই"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Čtyři ověřovací slova ukážou, že mezi vámi nikdo není"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fire bekræftelsesord viser, at ingen står imellem jer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vier Prüfwörter zeigen, dass niemand dazwischen sitzt"
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Τέσσερις λέξεις επαλήθευσης δείχνουν ότι δεν μπήκε κανείς στη μέση"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Four verification words show that nobody is in the middle"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cuatro palabras de verificación muestran que nadie está en medio"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "چهار کلمهٔ تأیید نشان می‌دهد که کسی در میانه نیست"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Neljä tarkistussanaa osoittaa, ettei välissä ole ketään"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quatre mots de vérification montrent que personne ne s'est interposé"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ארבע מילות אימות מראות שאף אחד לא נמצא באמצע"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "चार सत्यापन शब्द दिखाते हैं कि बीच में कोई नहीं है"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Négy ellenőrző szó mutatja, hogy senki sem áll közöttetek"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Empat kata verifikasi menunjukkan tidak ada pihak lain di tengah"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quattro parole di verifica mostrano che nessuno si è messo in mezzo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "4 つの確認用の単語で、間に誰もいないことを確かめられます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "확인 단어 네 개로 중간에 아무도 없다는 것을 확인합니다"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Empat perkataan pengesahan menunjukkan tiada sesiapa di tengah"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fire bekreftelsesord viser at ingen står imellom"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vier verificatiewoorden laten zien dat er niemand tussen zit"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cztery słowa weryfikacyjne pokazują, że nikt nie stoi pośrodku"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quatro palavras de verificação mostram que ninguém está no meio"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quatro palavras de verificação mostram que ninguém está no meio"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Patru cuvinte de verificare arată că nimeni nu stă la mijloc"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Четыре проверочных слова показывают, что посередине никого нет"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fyra verifieringsord visar att ingen sitter emellan"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Maneno manne ya uthibitisho yanaonyesha kwamba hakuna mtu katikati"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "คำยืนยันสี่คำแสดงว่าไม่มีใครแทรกอยู่ตรงกลาง"
          }
        },
        "tr": {
          "stringUnit": {
