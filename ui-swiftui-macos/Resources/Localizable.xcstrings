    "privacyModeConfirmBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ستصبح عمليات النقل أبطأ، لأن لا شيء ينتقل مباشرة بين الجهازين. يظل خادم الالتقاء وخادم الترحيل يريان عنوان IP الخاص بك، لكنهما لا يريان ملفاتك أو مفاتيحك أبدًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ট্রান্সফার ধীর হবে, কারণ ডিভাইসগুলোর মধ্যে কিছুই সরাসরি যায় না। সংযোগকারী সার্ভার ও রিলে সার্ভার তখনও আপনার IP ঠিকানা দেখে; তারা কখনও আপনার ফাইল বা কী দেখে না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Přenosy budou pomalejší, protože nic nepůjde přímo mezi zařízeními. Server pro navázání spojení a zprostředkující server stále vidí vaši IP adresu; vaše soubory ani klíče nikdy nevidí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Overførsler bliver langsommere, fordi intet går direkte mellem enhederne. Mødeserveren og relæserveren ser stadig din IP-adresse; de ser aldrig dine filer eller nøgler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Übertragungen werden langsamer, weil nichts direkt zwischen den Geräten läuft. Der Vermittlungsserver und der Relay-Server sehen weiterhin Ihre IP-Adresse, aber nie Ihre Dateien oder Schlüssel."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Οι μεταφορές θα είναι πιο αργές, γιατί τίποτα δεν πηγαίνει απευθείας μεταξύ των συσκευών. Ο διακομιστής συνάντησης και ο διακομιστής αναμετάδοσης εξακολουθούν να βλέπουν τη διεύθυνση IP σας· δεν βλέπουν ποτέ τα αρχεία ή τα κλειδιά σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transfers will be slower, because nothing goes directly between the devices. The rendezvous server and the relay still see your IP address; they never see your files or keys."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las transferencias serán más lentas, porque nada pasa directamente entre los dispositivos. El servidor de encuentro y el servidor de retransmisión siguen viendo tu dirección IP; nunca ven tus archivos ni tus claves."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "انتقال‌ها کندتر می‌شوند، چون هیچ چیز مستقیما بین دستگاه‌ها جابجا نمی‌شود. سرور هماهنگی و سرور رله همچنان نشانی IP شما را می‌بینند؛ ولی هرگز فایل‌ها یا کلیدهای شما را نمی‌بینند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Siirrot hidastuvat, koska mikään ei kulje suoraan laitteiden välillä. Kohtauspalvelin ja välityspalvelin näkevät edelleen IP-osoitteesi; ne eivät koskaan näe tiedostojasi tai avaimiasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les transferts seront plus lents, car rien ne passe directement entre les appareils. Le serveur de rendez-vous et le serveur relais voient toujours votre adresse IP ; ils ne voient jamais vos fichiers ni vos clés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ההעברות יהיו איטיות יותר, כי שום דבר לא עובר ישירות בין המכשירים. שרת המפגש ושרת הממסר עדיין רואים את כתובת ה־IP שלך; הם לעולם לא רואים את הקבצים או המפתחות שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ट्रांसफ़र धीमे होंगे, क्योंकि डिवाइस के बीच कुछ भी सीधे नहीं जाता। संपर्क सर्वर और रिले सर्वर फिर भी आपका IP पता देखते हैं; वे आपकी फ़ाइलें या कुंजियाँ कभी नहीं देखते।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Az átvitel lassabb lesz, mert semmi sem megy közvetlenül az eszközök között. A találkozási szerver és a továbbító szerver továbbra is látja az IP-címedet; a fájljaidat és a kulcsaidat soha."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Transfer akan lebih lambat, karena tidak ada yang dikirim langsung antarperangkat. Server pertemuan dan server relai tetap melihat alamat IP Anda; keduanya tidak pernah melihat file atau kunci Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I trasferimenti saranno più lenti, perché niente passa direttamente tra i dispositivi. Il server di incontro e il server di inoltro vedono comunque il tuo indirizzo IP; non vedono mai i tuoi file né le tue chiavi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "デバイス間で直接やり取りしなくなるため、転送は遅くなります。仲介サーバーとリレーには引き続き IP アドレスが見えますが、ファイルや鍵が見えることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "기기 간에 직접 전송되는 것이 없으므로 전송 속도가 느려집니다. 중개 서버와 릴레이는 여전히 IP 주소를 볼 수 있지만, 파일이나 키는 절대 볼 수 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pemindahan akan menjadi lebih perlahan, kerana tiada apa-apa yang bergerak terus antara peranti. Pelayan pertemuan dan pelayan geganti masih melihat alamat IP anda; kedua-duanya tidak pernah melihat fail atau kunci anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Overføringer blir tregere, fordi ingenting går direkte mellom enhetene. Møteserveren og reléserveren ser fortsatt IP-adressen din; de ser aldri filene eller nøklene dine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Overdrachten worden langzamer, omdat niets rechtstreeks tussen de apparaten gaat. De ontmoetingsserver en de relayserver zien je IP-adres nog steeds; je bestanden of sleutels zien ze nooit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Transfery będą wolniejsze, bo nic nie przechodzi bezpośrednio między urządzeniami. Serwer spotkań i serwer pośredniczący nadal widzą twój adres IP; nigdy nie widzą twoich plików ani kluczy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As transferências ficarão mais lentas, porque nada passa diretamente entre os dispositivos. O servidor de encontro e o servidor de retransmissão continuam vendo seu endereço IP; eles nunca veem seus arquivos nem suas chaves."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As transferências serão mais lentas, porque nada passa diretamente entre os dispositivos. O servidor de encontro e o servidor de retransmissão continuam a ver o seu endereço IP; nunca veem os seus ficheiros nem as suas chaves."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Transferurile vor fi mai lente, pentru că nimic nu merge direct între dispozitive. Serverul de întâlnire și serverul releu vă văd în continuare adresa IP; nu vă văd niciodată fișierele sau cheile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Передача будет медленнее, потому что ничего не идёт напрямую между устройствами. Сервер встречи и ретранслятор по-прежнему видят ваш IP-адрес, но никогда не видят ваши файлы и ключи."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Överföringar blir långsammare eftersom inget går direkt mellan enheterna. Mötesservern och reläservern ser fortfarande din IP-adress; de ser aldrig dina filer eller nycklar."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uhamishaji utakuwa wa polepole zaidi, kwa sababu hakuna kinachopita moja kwa moja kati ya vifaa. Seva ya kukutanisha na seva ya kati bado huona anwani yako ya IP; hazioni kamwe faili au funguo zako."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การโอนจะช้าลง เพราะไม่มีอะไรส่งระหว่างอุปกรณ์โดยตรง เซิร์ฟเวอร์นัดพบและเซิร์ฟเวอร์รีเลย์ยังคงเห็นที่อยู่ IP ของคุณ แต่ไม่เคยเห็นไฟล์หรือคีย์ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktarımlar yavaşlar, çünkü cihazlar arasında doğrudan hiçbir şey geçmez. Buluşma sunucusu ve aktarma sunucusu IP adresinizi yine görür; dosyalarınızı ya da anahtarlarınızı hiç görmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Передача буде повільнішою, бо нічого не йде напряму між пристроями. Сервер зустрічі й ретранслятор і далі бачать вашу IP-адресу, але ніколи не бачать ваших файлів і ключів."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "منتقلیاں سست ہو جائیں گی، کیونکہ کچھ بھی براہ راست آلات کے درمیان نہیں جاتا۔ رابطہ سرور اور ریلے پھر بھی آپ کا IP پتہ دیکھتے ہیں؛ وہ کبھی آپ کی فائلیں یا کلیدیں نہیں دیکھتے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Việc truyền sẽ chậm hơn, vì không có gì đi trực tiếp giữa các thiết bị. Máy chủ điểm hẹn và máy chủ chuyển tiếp vẫn thấy địa chỉ IP của bạn; chúng không bao giờ thấy tệp hay khóa của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "由于设备之间不再直接传输，传输会变慢。中介服务器和中继服务器仍会看到你的 IP 地址，但永远看不到你的文件或密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "由於裝置之間不再直接傳輸，傳輸會變慢。中介伺服器和中繼伺服器仍會看到你的 IP 位址，但絕對看不到你的檔案或金鑰。"
          }
        }
      }
    },
