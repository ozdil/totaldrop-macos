    "homeFooter": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "مشفّر بين الطرفين. بلا حساب ولا بريد إلكتروني ولا رقم هاتف."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এন্ড-টু-এন্ড এনক্রিপ্টেড। কোনো অ্যাকাউন্ট, ইমেল বা ফোন নম্বর লাগে না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Koncové šifrování. Žádný účet, e-mail ani telefonní číslo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "End-to-end-krypteret. Ingen konto, ingen e-mail, intet telefonnummer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ende-zu-Ende-verschlüsselt. Kein Konto, keine E-Mail, keine Telefonnummer."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Κρυπτογράφηση από άκρο σε άκρο. Χωρίς λογαριασμό, email ή αριθμό τηλεφώνου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End-to-end encrypted. No account, no email, no phone number."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cifrado de extremo a extremo. Sin cuenta, sin correo electrónico, sin número de teléfono."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "رمزگذاری سرتاسری. بدون حساب، بدون ایمیل، بدون شماره تلفن."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Päästä päähän salattu. Ei tiliä, ei sähköpostia, ei puhelinnumeroa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chiffré de bout en bout. Pas de compte, pas d'e-mail, pas de numéro de téléphone."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "מוצפן מקצה לקצה. בלי חשבון, בלי אימייל, בלי מספר טלפון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "एंड-टू-एंड एन्क्रिप्टेड। न खाता, न ईमेल, न फ़ोन नंबर।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Végpontok közötti titkosítás. Nincs fiók, e-mail-cím vagy telefonszám."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terenkripsi end-to-end. Tanpa akun, email, atau nomor telepon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Crittografia end-to-end. Nessun account, nessuna email, nessun numero di telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "エンドツーエンドで暗号化。アカウントもメールアドレスも電話番号も不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "종단간 암호화. 계정도, 이메일도, 전화번호도 필요 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Disulitkan hujung ke hujung. Tiada akaun, e-mel atau nombor telefon."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ende-til-ende-kryptert. Ingen konto, ingen e-post, intet telefonnummer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "End-to-end versleuteld. Geen account, geen e-mail, geen telefoonnummer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Szyfrowanie end-to-end. Bez konta, e-maila i numeru telefonu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Criptografia de ponta a ponta. Sem conta, sem e-mail, sem número de telefone."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Encriptação ponto a ponto. Sem conta, sem e-mail, sem número de telefone."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Criptat end-to-end. Fără cont, fără e-mail, fără număr de telefon."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сквозное шифрование. Без аккаунта, почты и номера телефона."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "End-to-end-krypterat. Inget konto, ingen e-post, inget telefonnummer."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Imesimbwa fiche kutoka mwanzo hadi mwisho. Hakuna akaunti, barua pepe wala nambari ya simu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เข้ารหัสตั้งแต่ต้นทางถึงปลายทาง ไม่ต้องมีบัญชี อีเมล หรือเบอร์โทรศัพท์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uçtan uca şifreli. Hesap, e-posta, telefon numarası yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Наскрізне шифрування. Без облікового запису, пошти й номера телефону."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اینڈ ٹو اینڈ انکرپٹڈ۔ نہ اکاؤنٹ، نہ ای میل، نہ فون نمبر۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mã hóa đầu cuối. Không cần tài khoản, email hay số điện thoại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "端到端加密。无需账号、邮箱或手机号码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "端對端加密。不需要帳號、電子郵件或手機號碼。"
          }
        }
      }
    },
