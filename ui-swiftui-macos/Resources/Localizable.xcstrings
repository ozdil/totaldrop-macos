            "state": "needs_review",
            "value": "رابطہ سرور"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Máy chủ điểm hẹn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "中介服务器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "中介伺服器"
          }
        }
      }
    },
    "settingsServerHelp": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يساعد جهازين يحملان الرمز نفسه على أن يجد أحدهما الآخر. لا يرى ملفاتك أو مفاتيحك أبدًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "একই কোডওয়ালা দুটি ডিভাইসকে একে অপরকে খুঁজে পেতে সাহায্য করে। এটি কখনও আপনার ফাইল বা কী দেখে না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pomáhá dvěma zařízením se stejným kódem najít se navzájem. Nikdy nevidí vaše soubory ani klíče."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hjælper to enheder med samme kode med at finde hinanden. Den ser aldrig dine filer eller nøgler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hilft zwei Geräten mit demselben Code, einander zu finden. Er sieht nie Ihre Dateien oder Schlüssel."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Βοηθά δύο συσκευές με τον ίδιο κωδικό να βρουν η μία την άλλη. Δεν βλέπει ποτέ τα αρχεία ή τα κλειδιά σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Helps two devices with the same code find each other. It never sees your files or keys."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ayuda a dos dispositivos con el mismo código a encontrarse. Nunca ve tus archivos ni tus claves."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "به دو دستگاه با کد یکسان کمک می‌کند یکدیگر را پیدا کنند. هرگز فایل‌ها یا کلیدهای شما را نمی‌بیند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Auttaa kahta saman koodin laitetta löytämään toisensa. Se ei koskaan näe tiedostojasi tai avaimiasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aide deux appareils ayant le même code à se trouver. Il ne voit jamais vos fichiers ni vos clés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "עוזר לשני מכשירים עם אותו קוד למצוא זה את זה. הוא לעולם לא רואה את הקבצים או המפתחות שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "एक ही कोड वाले दो डिवाइस को एक-दूसरे को ढूँढने में मदद करता है। यह आपकी फ़ाइलें या कुंजियाँ कभी नहीं देखता।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Segít, hogy két, azonos kódot használó eszköz megtalálja egymást. A fájljaidat és a kulcsaidat soha nem látja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Membantu dua perangkat dengan kode yang sama saling menemukan. Server ini tidak pernah melihat file atau kunci Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiuta due dispositivi con lo stesso codice a trovarsi. Non vede mai i tuoi file né le tue chiavi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "同じコードを持つ2台のデバイスが互いを見つけられるようにします。ファイルや鍵を見ることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "같은 코드를 가진 두 기기가 서로를 찾도록 돕습니다. 파일이나 키는 절대 보지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Membantu dua peranti dengan kod yang sama mencari satu sama lain. Ia tidak pernah melihat fail atau kunci anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hjelper to enheter med samme kode å finne hverandre. Den ser aldri filene eller nøklene dine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Helpt twee apparaten met dezelfde code elkaar te vinden. Hij ziet nooit je bestanden of sleutels."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pomaga dwóm urządzeniom z tym samym kodem odnaleźć się nawzajem. Nigdy nie widzi twoich plików ani kluczy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ajuda dois dispositivos com o mesmo código a se encontrarem. Ele nunca vê seus arquivos nem suas chaves."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ajuda dois dispositivos com o mesmo código a encontrarem-se. Nunca vê os seus ficheiros nem as suas chaves."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ajută două dispozitive cu același cod să se găsească. Nu vede niciodată fișierele sau cheile dvs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Помогает двум устройствам с одним кодом найти друг друга. Он никогда не видит ваши файлы и ключи."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hjälper två enheter med samma kod att hitta varandra. Den ser aldrig dina filer eller nycklar."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Husaidia vifaa viwili vyenye msimbo mmoja kupatana. Haioni kamwe faili au funguo zako."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ช่วยให้อุปกรณ์สองเครื่องที่ใช้รหัสเดียวกันหากันเจอ เซิร์ฟเวอร์นี้ไม่เคยเห็นไฟล์หรือคีย์ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı kodu bilen iki cihazın birbirini bulmasını sağlar. Dosyalarınızı ve anahtarlarınızı asla görmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Допомагає двом пристроям з однаковим кодом знайти одне одного. Він ніколи не бачить ваших файлів і ключів."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ایک ہی کوڈ والے دو آلات کو ایک دوسرے کو ڈھونڈنے میں مدد دیتا ہے۔ یہ کبھی آپ کی فائلیں یا کلیدیں نہیں دیکھتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Giúp hai thiết bị có cùng mã tìm thấy nhau. Máy chủ này không bao giờ thấy tệp hay khóa của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "帮助持有相同代码的两台设备找到彼此。它永远看不到你的文件或密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "協助持有相同代碼的兩部裝置找到彼此。它絕對看不到你的檔案或金鑰。"
          }
        }
      }
    },
