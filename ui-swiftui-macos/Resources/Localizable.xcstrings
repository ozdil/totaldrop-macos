      "comment": "Linux desktop notification when TotalDrop is started from the distribution package while the Flatpak window is already open; that window comes forward instead (#351)",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop مفتوح بالفعل من حزمة Flatpak، لذا أُبرزت تلك النافذة. استخدم حزمة واحدة في كل مرة: أغلق تلك النافذة لفتح هذه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop ইতিমধ্যে Flatpak থেকে খোলা আছে, তাই সেই উইন্ডোটি সামনে আনা হয়েছে। একবারে একটি প্যাকেজ ব্যবহার করুন: এটি খুলতে সেই উইন্ডোটি বন্ধ করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop je už otevřený z Flatpaku, takže se jeho okno přeneslo do popředí. Používejte vždy jen jeden balíček: pro otevření tohoto ukončete to okno."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop er allerede åben fra Flatpak, så det vindue blev bragt frem. Brug én pakke ad gangen: luk det vindue for at åbne denne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop ist bereits aus dem Flatpak geöffnet, daher wurde das geöffnete Fenster nach vorn geholt. Verwenden Sie jeweils nur ein Paket: Beenden Sie das geöffnete Fenster, um dieses Paket zu öffnen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Το TotalDrop είναι ήδη ανοιχτό από το Flatpak, οπότε εκείνο το παράθυρο ήρθε μπροστά. Χρησιμοποιείτε ένα πακέτο τη φορά: κλείστε εκείνο το παράθυρο για να ανοίξετε αυτό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TotalDrop is already open from the Flatpak, so that window was brought forward. Use one package at a time: quit that window to open this one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop ya está abierto desde el Flatpak, así que esa ventana se trajo al frente. Use un solo paquete a la vez: cierre esa ventana para abrir este."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop از قبل از Flatpak باز است، پس همان پنجره جلو آورده شد. هر بار فقط از یک بسته استفاده کنید: برای باز کردن این یکی، از آن پنجره خارج شوید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop on jo auki Flatpakista, joten sen ikkuna tuotiin eteen. Käytä vain yhtä pakettia kerrallaan: sulje se ikkuna avataksesi tämän."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop est déjà ouvert depuis le Flatpak : cette fenêtre a été ramenée au premier plan. Utilisez un seul paquet à la fois : quittez cette fenêtre pour ouvrir celui-ci."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop כבר פתוח מ־Flatpak, ולכן החלון הפתוח הובא לחזית. השתמשו בחבילה אחת בכל פעם: צאו מהחלון הפתוח כדי לפתוח את זו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop पहले से Flatpak से खुला है, इसलिए वही विंडो सामने लाई गई। एक समय में एक ही पैकेज इस्तेमाल करें: इसे खोलने के लिए उस विंडो को बंद करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A TotalDrop már nyitva van a Flatpakból, ezért az az ablak került előtérbe. Egyszerre csak egy csomagot használjon: ennek megnyitásához lépjen ki abból az ablakból."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop sudah terbuka dari Flatpak, jadi jendela itu dimunculkan. Gunakan satu paket dalam satu waktu: tutup jendela itu untuk membuka yang ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop è già aperto dal Flatpak, quindi quella finestra è stata portata in primo piano. Usa un solo pacchetto alla volta: chiudi quella finestra per aprire questo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop はすでに Flatpak 版で開いているため、そのウィンドウを前面に出しました。パッケージは一度に 1 つだけ使ってください。こちらを開くには、そのウィンドウを終了してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop이 이미 Flatpak으로 열려 있어 그 창을 앞으로 가져왔습니다. 패키지는 한 번에 하나만 사용하세요. 이 패키지를 열려면 그 창을 종료하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop sudah dibuka daripada Flatpak, jadi tetingkap itu dibawa ke hadapan. Gunakan satu pakej pada satu masa: tutup tetingkap itu untuk membuka yang ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop er allerede åpen fra Flatpak, så det vinduet ble hentet frem. Bruk én pakke om gangen: avslutt det vinduet for å åpne denne."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop is al geopend vanuit de Flatpak, dus dat venster is naar voren gehaald. Gebruik één pakket tegelijk: sluit dat venster om dit te openen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop jest już otwarty z Flatpaka, więc przywołano to okno. Używaj jednocześnie tylko jednego pakietu: zamknij tamto okno, aby otworzyć ten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O TotalDrop já está aberto pelo Flatpak, então essa janela foi trazida para a frente. Use um pacote por vez: feche essa janela para abrir este."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O TotalDrop já está aberto a partir do Flatpak, por isso essa janela foi trazida para a frente. Use um pacote de cada vez: feche essa janela para abrir este."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop este deja deschis din Flatpak, așa că acea fereastră a fost adusă în față. Folosiți un singur pachet odată: închideți acea fereastră pentru a-l deschide pe acesta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop уже открыт из Flatpak, поэтому то окно выведено на передний план. Используйте одновременно только один пакет: закройте то окно, чтобы открыть этот."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop är redan öppet från Flatpak, så det fönstret togs fram. Använd ett paket i taget: avsluta det fönstret för att öppna det här."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop tayari iko wazi kutoka Flatpak, kwa hivyo dirisha hilo limeletwa mbele. Tumia kifurushi kimoja kwa wakati mmoja: funga dirisha hilo ili kufungua hiki."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop เปิดอยู่แล้วจาก Flatpak จึงนำหน้าต่างนั้นขึ้นมาด้านหน้า ใช้แพ็กเกจครั้งละหนึ่งแพ็กเกจ: ปิดหน้าต่างนั้นเพื่อเปิดอันนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TotalDrop zaten Flatpak'ten açık, o pencere öne getirildi. Aynı anda tek paket kullanın: bunu açmak için o pencereden çıkın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop уже відкрито з Flatpak, тож те вікно виведено на передній план. Використовуйте одночасно лише один пакет: закрийте те вікно, щоб відкрити цей."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop پہلے ہی Flatpak سے کھلا ہے، اس لیے وہی ونڈو سامنے لائی گئی۔ ایک وقت میں ایک ہی پیکیج استعمال کریں: اسے کھولنے کے لیے اس ونڈو کو بند کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop đang mở từ bản Flatpak, nên cửa sổ đó đã được đưa lên trước. Mỗi lúc chỉ dùng một gói: thoát cửa sổ đó để mở bản này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop 已从 Flatpak 打开，因此已将该窗口带到前台。请一次只使用一个软件包：要打开这个，请先退出那个窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop 已從 Flatpak 開啟，因此已將該視窗帶到前景。請一次只使用一個套件：要開啟這個，請先結束那個視窗。"
          }
        }
      }
