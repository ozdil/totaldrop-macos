    "causeNoRoute": {
      "comment": "Under Details of a failed transfer: why it failed, in plain words",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لم تنجح أي طريقة للوصول إلى الجهاز الآخر، لا مباشرة ولا عبر خادم الترحيل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "সরাসরি বা রিলে সার্ভারের মাধ্যমে, কোনো উপায়েই অন্য ডিভাইসে পৌঁছানো যায়নি।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Druhé zařízení se nepodařilo zastihnout přímo ani přes zprostředkující server."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Den anden enhed kunne ikke nås, hverken direkte eller gennem relæserveren."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das andere Gerät war weder direkt noch über den Relay-Server erreichbar."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Η άλλη συσκευή δεν ήταν προσβάσιμη ούτε απευθείας ούτε μέσω του διακομιστή αναμετάδοσης."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No way of reaching the other device worked, directly or through the relay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se pudo llegar al otro dispositivo, ni directamente ni a través del servidor de retransmisión."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "هیچ راهی برای رسیدن به دستگاه دیگر جواب نداد، نه مستقیم و نه از طریق سرور رله."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toista laitetta ei tavoitettu suoraan eikä välityspalvelimen kautta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossible de joindre l'autre appareil, ni directement ni par le serveur relais."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "לא ניתן היה להגיע למכשיר השני, לא ישירות ולא דרך שרת הממסר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "दूसरे डिवाइस तक न सीधे पहुँचा जा सका, न रिले सर्वर के ज़रिए।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
