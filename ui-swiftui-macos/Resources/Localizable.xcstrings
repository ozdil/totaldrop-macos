    "linkBusy": {
      "comment": "Android: shown when a TotalDrop link (totaldrop://r/… or https://totaldrop.app/r#…) opens the app while Receive cannot take a new code: a send or receive is running, an offer waits for an answer, or a received text is shown. The screen it refers to is shown; the link's code is not filled in",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أنهِ ما على الشاشة أو أوقفه، ثم افتح الرابط مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "স্ক্রিনে যা আছে তা শেষ করুন বা থামান, তারপর লিংকটি আবার খুলুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dokončete nebo zastavte to, co je na obrazovce, a pak odkaz otevřete znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gør det færdigt, der er på skærmen, eller stop det, og åbn så linket igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schließe ab oder stoppe, was auf dem Bildschirm ist, und öffne dann den Link erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ολοκληρώστε ή σταματήστε ό,τι είναι στην οθόνη και ανοίξτε ξανά τον σύνδεσμο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish or stop what is on the screen, then open the link again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Termina o detén lo que hay en la pantalla y vuelve a abrir el enlace."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "کاری را که روی صفحه است تمام یا متوقف کنید، سپس پیوند را دوباره باز کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vie loppuun tai pysäytä se, mikä on näytöllä, ja avaa linkki sitten uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terminez ou arrêtez ce qui est à l’écran, puis rouvrez le lien."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "סיימו או עצרו את מה שמוצג במסך, ואז פתחו שוב את הקישור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "स्क्रीन पर जो है उसे पूरा करें या रोकें, फिर लिंक दोबारा खोलें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fejezd be vagy állítsd le, ami a képernyőn van, aztán nyisd meg újra a linket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Selesaikan atau hentikan apa yang ada di layar, lalu buka tautannya lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Completa o interrompi ciò che è sullo schermo, poi riapri il link."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "画面上の操作を完了するか停止してから、もう一度リンクを開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "화면에 있는 작업을 마치거나 중지한 다음 링크를 다시 여세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Selesaikan atau hentikan apa yang ada pada skrin, kemudian buka pautan itu semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fullfør eller stopp det som er på skjermen, og åpne lenken på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rond af of stop wat op het scherm staat en open de link dan opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dokończ lub zatrzymaj to, co jest na ekranie, a potem otwórz link ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Termine ou pare o que está na tela e abra o link de novo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Termine ou pare o que está no ecrã e depois abra o link novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Finalizează sau oprește ce este pe ecran, apoi deschide din nou linkul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Завершите или остановите то, что на экране, затем снова откройте ссылку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Slutför eller stoppa det som visas på skärmen och öppna sedan länken igen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Maliza au simamisha kilicho kwenye skrini, kisha fungua kiungo tena."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ทำสิ่งที่อยู่บนหน้าจอให้เสร็จหรือหยุดก่อน แล้วเปิดลิงก์อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce ekrandakini bitirin ya da durdurun, sonra TotalDrop bağlantısını yeniden açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Завершіть або зупиніть те, що на екрані, а потім знову відкрийте посилання."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اسکرین پر موجود کام مکمل کریں یا روکیں، پھر لنک دوبارہ کھولیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hãy hoàn tất hoặc dừng nội dung trên màn hình, rồi mở lại liên kết."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请先完成或停止屏幕上的操作，然后再次打开链接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "請先完成或停止螢幕上的操作，然後再次開啟連結。"
          }
        }
      }
    },
    "metainfoAbout": {
      "comment": "Linux software centres: the paragraph that introduces TotalDrop on its page",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يرسل TotalDrop الملفات والمجلدات من جهاز إلى آخر بتشفير تام بين الطرفين. اختر الملفات وشارك رمزًا قصيرًا أو رمز QR، فيستلمها الجهاز الآخر. بلا حساب ولا بريد إلكتروني ولا رقم هاتف."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop এক ডিভাইস থেকে আরেক ডিভাইসে ফাইল ও ফোল্ডার পাঠায়, এন্ড-টু-এন্ড এনক্রিপ্টেড। ফাইল বেছে নিন, একটি ছোট কোড বা QR কোড শেয়ার করুন, আর অন্য ডিভাইস সেগুলো পেয়ে যাবে। কোনো অ্যাকাউন্ট, ইমেল বা ফোন নম্বর লাগে না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop posílá soubory a složky z jednoho zařízení do druhého, koncově šifrované. Vyberte soubory, sdílejte krátký kód nebo QR kód a druhé zařízení je přijme. Žádný účet, e-mail ani telefonní číslo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop sender filer og mapper fra én enhed til en anden, end-to-end-krypteret. Vælg filerne, del en kort kode eller en QR-kode, og den anden enhed modtager dem. Ingen konto, ingen e-mail, intet telefonnummer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop sendet Dateien und Ordner von einem Gerät zum anderen, Ende-zu-Ende-verschlüsselt. Wählen Sie die Dateien aus, teilen Sie einen kurzen Code oder einen QR-Code, und das andere Gerät empfängt sie. Kein Konto, keine E-Mail, keine Telefonnummer."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Το TotalDrop στέλνει αρχεία και φακέλους από μια συσκευή σε άλλη, με κρυπτογράφηση από άκρο σε άκρο. Επιλέξτε τα αρχεία, μοιραστείτε έναν σύντομο κωδικό ή έναν κωδικό QR, και η άλλη συσκευή τα λαμβάνει. Χωρίς λογαριασμό, email ή αριθμό τηλεφώνου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TotalDrop sends files and folders from one device to another, end-to-end encrypted. Pick the files, share a short code or a QR code, and the other device receives them. No account, no email, no phone number."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop envía archivos y carpetas de un dispositivo a otro, con cifrado de extremo a extremo. Elige los archivos, comparte un código corto o un código QR y el otro dispositivo los recibe. Sin cuenta, sin correo electrónico, sin número de teléfono."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop فایل‌ها و پوشه‌ها را با رمزگذاری سرتاسری از یک دستگاه به دستگاه دیگر می‌فرستد. فایل‌ها را انتخاب کنید، یک کد کوتاه یا کد QR را به اشتراک بگذارید تا دستگاه دیگر آن‌ها را دریافت کند. بدون حساب کاربری، ایمیل یا شماره تلفن."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop lähettää tiedostoja ja kansioita laitteesta toiseen päästä päähän salattuina. Valitse tiedostot, jaa lyhyt koodi tai QR-koodi, ja toinen laite vastaanottaa ne. Ei tiliä, ei sähköpostia, ei puhelinnumeroa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop envoie des fichiers et des dossiers d'un appareil à un autre, chiffrés de bout en bout. Choisissez les fichiers, partagez un code court ou un code QR, et l'autre appareil les reçoit. Pas de compte, pas d'e-mail, pas de numéro de téléphone."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop שולח קבצים ותיקיות ממכשיר אחד לאחר, בהצפנה מקצה לקצה. בוחרים את הקבצים, משתפים קוד קצר או קוד QR, והמכשיר השני מקבל אותם. בלי חשבון, בלי דוא״ל, בלי מספר טלפון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop फ़ाइलें और फ़ोल्डर एक डिवाइस से दूसरे पर भेजता है, एंड-टू-एंड एन्क्रिप्टेड। फ़ाइलें चुनें, एक छोटा कोड या QR कोड शेयर करें, और दूसरा डिवाइस उन्हें पा लेगा। न खाता, न ईमेल, न फ़ोन नंबर।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A TotalDrop fájlokat és mappákat küld egyik eszközről a másikra, végpontok közötti titkosítással. Válaszd ki a fájlokat, oszd meg a rövid kódot vagy a QR-kódot, és a másik eszköz megkapja őket. Nincs fiók, e-mail-cím vagy telefonszám."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop mengirim file dan folder dari satu perangkat ke perangkat lain, terenkripsi end-to-end. Pilih file, bagikan kode pendek atau kode QR, dan perangkat lain akan menerimanya. Tanpa akun, tanpa email, tanpa nomor telepon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop invia file e cartelle da un dispositivo all'altro, con crittografia end-to-end. Scegli i file, condividi un codice breve o un codice QR e l'altro dispositivo li riceve. Nessun account, nessuna email, nessun numero di telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop は、ファイルやフォルダーをデバイスから別のデバイスへエンドツーエンドで暗号化して送ります。ファイルを選んで短いコードか QR コードを共有すれば、相手のデバイスが受け取ります。アカウントもメールアドレスも電話番号も不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop은 파일과 폴더를 한 기기에서 다른 기기로 종단 간 암호화하여 보냅니다. 파일을 고르고 짧은 코드나 QR 코드를 공유하면 다른 기기가 받습니다. 계정도, 이메일도, 전화번호도 필요 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop menghantar fail dan folder dari satu peranti ke peranti lain, disulitkan hujung ke hujung. Pilih fail, kongsi kod pendek atau kod QR, dan peranti lain akan menerimanya. Tiada akaun, tiada e-mel, tiada nombor telefon."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop sender filer og mapper fra én enhet til en annen, ende-til-ende-kryptert. Velg filene, del en kort kode eller en QR-kode, så mottar den andre enheten dem. Ingen konto, ingen e-post, ikke noe telefonnummer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop stuurt bestanden en mappen van het ene apparaat naar het andere, end-to-end versleuteld. Kies de bestanden, deel een korte code of een QR-code, en het andere apparaat ontvangt ze. Geen account, geen e-mail, geen telefoonnummer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop wysyła pliki i foldery z jednego urządzenia na drugie, z szyfrowaniem end-to-end. Wybierz pliki, udostępnij krótki kod lub kod QR, a drugie urządzenie je odbierze. Bez konta, bez e-maila, bez numeru telefonu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O TotalDrop envia arquivos e pastas de um dispositivo para outro, com criptografia de ponta a ponta. Escolha os arquivos, compartilhe um código curto ou um QR code e o outro dispositivo os recebe. Sem conta, sem e-mail, sem número de telefone."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O TotalDrop envia ficheiros e pastas de um dispositivo para outro, com encriptação de ponta a ponta. Escolha os ficheiros, partilhe um código curto ou um código QR e o outro dispositivo recebe-os. Sem conta, sem e-mail, sem número de telefone."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop trimite fișiere și dosare de pe un dispozitiv pe altul, criptate integral. Alegeți fișierele, partajați un cod scurt sau un cod QR, iar celălalt dispozitiv le primește. Fără cont, fără e-mail, fără număr de telefon."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop передаёт файлы и папки с одного устройства на другое со сквозным шифрованием. Выберите файлы, поделитесь коротким кодом или QR-кодом, и другое устройство их получит. Без учётной записи, почты и номера телефона."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop skickar filer och mappar från en enhet till en annan, end-to-end-krypterat. Välj filerna, dela en kort kod eller en QR-kod, så tar den andra enheten emot dem. Inget konto, ingen e-post, inget telefonnummer."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop hutuma faili na folda kutoka kifaa kimoja hadi kingine, zimesimbwa mwanzo hadi mwisho. Chagua faili, shiriki msimbo mfupi au msimbo wa QR, na kifaa kingine kitazipokea. Hakuna akaunti, barua pepe wala nambari ya simu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop ส่งไฟล์และโฟลเดอร์จากอุปกรณ์หนึ่งไปยังอีกอุปกรณ์ เข้ารหัสตั้งแต่ต้นทางถึงปลายทาง เลือกไฟล์ แชร์รหัสสั้นหรือรหัส QR แล้วอุปกรณ์อีกเครื่องจะได้รับไฟล์ ไม่ต้องมีบัญชี อีเมล หรือหมายเลขโทรศัพท์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TotalDrop dosya ve klasörleri bir cihazdan diğerine uçtan uca şifreli gönderir. Dosyaları seçin, kısa bir kodu ya da QR kodunu paylaşın, diğer cihaz dosyaları alsın. Hesap, e-posta, telefon numarası yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop надсилає файли й теки з одного пристрою на інший із наскрізним шифруванням. Виберіть файли, поділіться коротким кодом або QR-кодом, і інший пристрій їх отримає. Без облікового запису, пошти й номера телефону."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop فائلیں اور فولڈر ایک آلے سے دوسرے پر اینڈ ٹو اینڈ انکرپشن کے ساتھ بھیجتا ہے۔ فائلیں چنیں، ایک مختصر کوڈ یا QR کوڈ شیئر کریں، اور دوسرا آلہ انہیں وصول کر لے گا۔ نہ اکاؤنٹ، نہ ای میل، نہ فون نمبر۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop gửi tệp và thư mục từ thiết bị này sang thiết bị khác, mã hóa đầu cuối. Chọn tệp, chia sẻ một mã ngắn hoặc mã QR, và thiết bị kia sẽ nhận được. Không cần tài khoản, email hay số điện thoại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop 将文件和文件夹从一台设备发送到另一台设备，端到端加密。选择文件，分享一个短代码或二维码，另一台设备就会收到。无需账户、电子邮件或电话号码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop 將檔案和資料夾從一台裝置傳送到另一台裝置，端對端加密。選擇檔案，分享一組短代碼或 QR 碼，另一台裝置就會收到。不需要帳號、電子郵件或電話號碼。"
          }
        }
      }
    },
    "metainfoOnePackage": {
      "comment": "Linux software centres: last paragraph of the description; the Flatpak and the distribution package (.pkg, .deb, .rpm) cannot run at the same time (#351). Keep .pkg, .deb, .rpm and Flatpak as they are",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "استخدم حزمة Linux واحدة في كل مرة. تشترك حزمة Flatpak وحزمة .pkg أو .deb أو .rpm في اسم واحد، لذا عندما تكون إحداهما مفتوحة، يؤدي تشغيل الأخرى إلى إبراز النافذة المفتوحة بدلًا من فتح نافذة ثانية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "একবারে একটি Linux প্যাকেজ ব্যবহার করুন। Flatpak এবং .pkg, .deb বা .rpm প্যাকেজের নাম একই, তাই একটি খোলা থাকলে অন্যটি চালু করলে দ্বিতীয় উইন্ডো খোলে না, খোলা উইন্ডোটি সামনে আসে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Používejte vždy jen jeden linuxový balíček. Flatpak a balíček .pkg, .deb nebo .rpm sdílejí jeden název, takže když je jeden otevřený, spuštění druhého jen přenese otevřené okno do popředí, místo aby otevřelo druhé."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Brug én Linux-pakke ad gangen. Flatpak-pakken og .pkg-, .deb- eller .rpm-pakken deler ét navn, så mens den ene er åben, bringer start af den anden det åbne vindue frem i stedet for at åbne et nyt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verwenden Sie unter Linux jeweils nur ein Paket. Das Flatpak und das .pkg-, .deb- oder .rpm-Paket teilen sich einen Namen: Ist eines geöffnet, holt der Start des anderen das offene Fenster nach vorn, statt ein zweites zu öffnen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Χρησιμοποιείτε ένα πακέτο Linux τη φορά. Το Flatpak και το πακέτο .pkg, .deb ή .rpm μοιράζονται ένα όνομα, οπότε όσο το ένα είναι ανοιχτό, η εκκίνηση του άλλου φέρνει μπροστά το ανοιχτό παράθυρο αντί να ανοίξει δεύτερο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use one Linux package at a time. The Flatpak and the .pkg, .deb or .rpm package share one name, so while one of them is open, starting the other brings the open window forward instead of opening a second one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Use un solo paquete de Linux a la vez. El Flatpak y el paquete .pkg, .deb o .rpm comparten un nombre, así que mientras uno está abierto, iniciar el otro trae al frente la ventana abierta en lugar de abrir una segunda."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "هر بار فقط از یک بسته Linux استفاده کنید. Flatpak و بسته .pkg، .deb یا .rpm یک نام مشترک دارند، پس وقتی یکی باز است، اجرای دیگری به‌جای باز کردن پنجره دوم، پنجره باز را جلو می‌آورد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Käytä vain yhtä Linux-pakettia kerrallaan. Flatpakilla ja .pkg-, .deb- tai .rpm-paketilla on sama nimi, joten kun toinen on auki, toisen käynnistäminen tuo avoimen ikkunan eteen eikä avaa toista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Utilisez un seul paquet Linux à la fois. Le Flatpak et le paquet .pkg, .deb ou .rpm partagent un même nom : quand l'un est ouvert, lancer l'autre ramène la fenêtre ouverte au premier plan au lieu d'en ouvrir une seconde."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "השתמשו בחבילת Linux אחת בכל פעם. ל־Flatpak ולחבילת .pkg, .deb או .rpm יש שם משותף, ולכן כשאחת פתוחה, הפעלת השנייה מביאה לחזית את החלון הפתוח במקום לפתוח חלון שני."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "एक समय में एक ही Linux पैकेज इस्तेमाल करें। Flatpak और .pkg, .deb या .rpm पैकेज का नाम एक ही है, इसलिए एक खुला हो तो दूसरा चलाने पर दूसरी विंडो नहीं खुलती, खुली विंडो सामने आ जाती है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Egyszerre csak egy Linux-csomagot használjon. A Flatpak és a .pkg, .deb vagy .rpm csomag neve azonos, ezért ha az egyik nyitva van, a másik indítása nem nyit új ablakot, hanem előtérbe hozza a nyitottat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gunakan satu paket Linux dalam satu waktu. Flatpak dan paket .pkg, .deb, atau .rpm memakai nama yang sama, jadi saat salah satunya terbuka, menjalankan yang lain akan memunculkan jendela yang terbuka alih-alih membuka jendela kedua."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usa un solo pacchetto Linux alla volta. Il Flatpak e il pacchetto .pkg, .deb o .rpm condividono un nome, quindi mentre uno è aperto, avviare l'altro porta in primo piano la finestra aperta invece di aprirne una seconda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Linux のパッケージは一度に 1 つだけ使ってください。Flatpak と .pkg・.deb・.rpm パッケージは同じ名前を使うため、一方を開いている間にもう一方を起動すると、2 つ目のウィンドウは開かず、開いているウィンドウが前面に出ます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Linux 패키지는 한 번에 하나만 사용하세요. Flatpak과 .pkg, .deb 또는 .rpm 패키지는 같은 이름을 쓰기 때문에, 하나가 열려 있을 때 다른 하나를 실행하면 두 번째 창이 열리지 않고 열려 있는 창이 앞으로 나옵니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gunakan satu pakej Linux pada satu masa. Flatpak dan pakej .pkg, .deb atau .rpm berkongsi satu nama, jadi semasa salah satunya dibuka, memulakan yang lain akan membawa tetingkap yang terbuka ke hadapan dan bukannya membuka tetingkap kedua."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bruk én Linux-pakke om gangen. Flatpak-pakken og .pkg-, .deb- eller .rpm-pakken deler ett navn, så mens den ene er åpen, henter start av den andre det åpne vinduet frem i stedet for å åpne et nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gebruik één Linux-pakket tegelijk. Het Flatpak-pakket en het .pkg-, .deb- of .rpm-pakket delen één naam, dus terwijl het ene open is, haalt het starten van het andere het open venster naar voren in plaats van een tweede te openen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Używaj jednocześnie tylko jednego pakietu dla Linuksa. Flatpak i pakiet .pkg, .deb lub .rpm mają wspólną nazwę, więc gdy jeden jest otwarty, uruchomienie drugiego przywołuje otwarte okno zamiast otwierać drugie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Use um pacote Linux por vez. O Flatpak e o pacote .pkg, .deb ou .rpm compartilham um nome, então enquanto um está aberto, iniciar o outro traz a janela aberta para a frente em vez de abrir uma segunda."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Use um pacote Linux de cada vez. O Flatpak e o pacote .pkg, .deb ou .rpm partilham um nome, por isso, enquanto um está aberto, iniciar o outro traz a janela aberta para a frente em vez de abrir uma segunda."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Folosiți un singur pachet Linux odată. Flatpak-ul și pachetul .pkg, .deb sau .rpm au același nume, așa că, dacă unul este deschis, pornirea celuilalt aduce în față fereastra deschisă în loc să deschidă una nouă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Используйте одновременно только один пакет для Linux. У Flatpak и пакета .pkg, .deb или .rpm одно имя, поэтому, пока один открыт, запуск другого выводит открытое окно на передний план, а не открывает второе."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Använd ett Linux-paket i taget. Flatpak-paketet och .pkg-, .deb- eller .rpm-paketet delar ett namn, så medan det ena är öppet tar en start av det andra fram det öppna fönstret i stället för att öppna ett nytt."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tumia kifurushi kimoja cha Linux kwa wakati mmoja. Flatpak na kifurushi cha .pkg, .deb au .rpm vinashiriki jina moja, kwa hivyo kimoja kikiwa wazi, kuanzisha kingine huleta dirisha lililo wazi mbele badala ya kufungua dirisha la pili."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ใช้แพ็กเกจ Linux ครั้งละหนึ่งแพ็กเกจ Flatpak กับแพ็กเกจ .pkg, .deb หรือ .rpm ใช้ชื่อเดียวกัน ขณะที่อันหนึ่งเปิดอยู่ การเปิดอีกอันจะนำหน้าต่างที่เปิดอยู่ขึ้นมาด้านหน้าแทนการเปิดหน้าต่างที่สอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux'ta aynı anda tek paket kullanın. Flatpak ile .pkg, .deb ya da .rpm paketi aynı adı paylaşır; biri açıkken ötekini başlatmak ikinci bir pencere açmaz, açık pencereyi öne getirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Використовуйте одночасно лише один пакет для Linux. Flatpak і пакет .pkg, .deb чи .rpm мають спільне ім'я, тож поки один відкритий, запуск іншого виводить відкрите вікно на передній план, а не відкриває друге."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ایک وقت میں ایک ہی Linux پیکیج استعمال کریں۔ Flatpak اور .pkg، .deb یا .rpm پیکیج کا نام ایک ہی ہے، اس لیے جب ایک کھلا ہو تو دوسرا چلانے سے دوسری ونڈو نہیں کھلتی بلکہ کھلی ونڈو سامنے آ جاتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mỗi lúc chỉ dùng một gói Linux. Bản Flatpak và gói .pkg, .deb hoặc .rpm dùng chung một tên, nên khi một bản đang mở, khởi động bản kia sẽ đưa cửa sổ đang mở lên trước thay vì mở cửa sổ thứ hai."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请一次只使用一个 Linux 软件包。Flatpak 与 .pkg、.deb 或 .rpm 软件包使用同一个名称，因此当其中一个已打开时，启动另一个只会把已打开的窗口带到前台，而不会再打开一个窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "請一次只使用一個 Linux 套件。Flatpak 與 .pkg、.deb 或 .rpm 套件使用同一個名稱，因此當其中一個已開啟時，啟動另一個只會把已開啟的視窗帶到前景，而不會再開啟一個視窗。"
          }
        }
      }
    },
