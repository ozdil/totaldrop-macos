        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এই কোডটি ব্যবহারে নেই: এটি ভুল টাইপ হয়েছে, মেয়াদ শেষ হয়ে গেছে অথবা আগেই ব্যবহার করা হয়েছে। প্রেরকের কাছে নতুন কোড চেয়ে নিন।"
