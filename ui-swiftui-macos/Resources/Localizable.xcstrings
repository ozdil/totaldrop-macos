    "receiveTextHidden": {
      "comment": "Receive result: the text holds invisible control or direction characters, shown in the text by their code, as <U+202E>; keep U+… as it is",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يحتوي النص على أحرف مخفية تظهر على شكل U+…. عند النسخ يُنسخ النص كما وصل تمامًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "লেখায় লুকানো অক্ষর আছে, সেগুলো U+… হিসেবে দেখানো হচ্ছে। কপি করলে লেখাটি ঠিক যেমন এসেছে তেমনই কপি হয়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Text obsahuje skryté znaky, zobrazené jako U+…. Zkopírováním získáte text přesně tak, jak dorazil."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Teksten indeholder skjulte tegn, som vises som U+…. Når du kopierer, får du teksten præcis, som den kom."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Text enthält versteckte Zeichen, angezeigt als U+…. Beim Kopieren erhalten Sie den Text genau so, wie er ankam."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Το κείμενο περιέχει κρυφούς χαρακτήρες, που εμφανίζονται ως U+…. Η αντιγραφή δίνει το κείμενο ακριβώς όπως ήρθε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The text holds hidden characters, shown as U+…. Copying gives the text exactly as it came."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El texto contiene caracteres ocultos, que se muestran como U+…. Al copiarlo obtienes el texto exactamente como llegó."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "متن نویسه‌های پنهان دارد که به‌صورت U+… نمایش داده می‌شوند. با کپی کردن، متن دقیقاً همان‌طور که رسیده کپی می‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tekstissä on piilomerkkejä, jotka näytetään muodossa U+…. Kopioitaessa saat tekstin täsmälleen sellaisena kuin se saapui."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le texte contient des caractères cachés, affichés sous la forme U+…. La copie donne le texte exactement tel qu’il est arrivé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הטקסט מכיל תווים נסתרים, המוצגים כ־U+…. העתקה נותנת את הטקסט בדיוק כפי שהגיע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "टेक्स्ट में छिपे हुए अक्षर हैं, जो U+… के रूप में दिखाए गए हैं। कॉपी करने पर टेक्स्ट ठीक वैसा ही मिलता है जैसा आया था।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A szövegben rejtett karakterek vannak, ezek U+… alakban látszanak. Másoláskor a szöveget pontosan úgy kapod meg, ahogy érkezett."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Teks berisi karakter tersembunyi yang ditampilkan sebagai U+…. Saat disalin, teks didapat persis seperti saat tiba."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il testo contiene caratteri nascosti, mostrati come U+…. Copiandolo ottieni il testo esattamente come è arrivato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "テキストに見えない文字が含まれており、U+… の形で表示しています。コピーすると、届いたとおりのテキストがコピーされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "텍스트에 숨겨진 문자가 있어 U+… 형태로 표시합니다. 복사하면 도착한 그대로의 텍스트가 복사됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Teks mengandungi aksara tersembunyi yang dipaparkan sebagai U+…. Apabila disalin, teks diperoleh tepat seperti ia tiba."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Teksten inneholder skjulte tegn, som vises som U+…. Når du kopierer, får du teksten nøyaktig slik den kom."
