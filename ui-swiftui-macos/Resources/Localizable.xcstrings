{
  "sourceLanguage": "en",
  "strings": {
    "appTagline": {
      "comment": "Short slogan under the app name on the home screen",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أي ملف، لأي شخص، في أي مكان."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "যেকোনো ফাইল, যে কাউকে, যেকোনো জায়গায়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jakýkoli soubor, komukoli, kamkoli."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Enhver fil, til alle, overalt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jede Datei, an jeden, überallhin."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Οποιοδήποτε αρχείο, σε οποιονδήποτε, οπουδήποτε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Any file, to anyone, anywhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cualquier archivo, a cualquier persona, en cualquier lugar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "هر فایلی، برای هر کسی، در هر جایی."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mikä tahansa tiedosto, kenelle tahansa, minne tahansa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "N'importe quel fichier, à n'importe qui, n'importe où."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "כל קובץ, לכל אחד, לכל מקום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हर फ़ाइल, हर किसी को, हर जगह।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bármilyen fájlt, bárkinek, bárhová."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "File apa pun, untuk siapa pun, di mana pun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Qualsiasi file, a chiunque, ovunque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "どんなファイルも、誰にでも、どこへでも。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "어떤 파일이든, 누구에게나, 어디로든."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sebarang fail, kepada sesiapa, di mana-mana."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvilken som helst fil, til hvem som helst, hvor som helst."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elk bestand, naar iedereen, overal."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Każdy plik, do każdego, wszędzie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Qualquer arquivo, para qualquer pessoa, em qualquer lugar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Qualquer ficheiro, para qualquer pessoa, em qualquer lugar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Orice fișier, oricui, oriunde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Любой файл, кому угодно, куда угодно."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vilken fil som helst, till vem som helst, var som helst."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Faili yoyote, kwa yeyote, popote."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ทุกไฟล์ ถึงทุกคน ทุกที่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her dosyayı, herkese, her yere."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Будь-який файл, будь-кому, будь-куди."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "کوئی بھی فائل، کسی کو بھی، کہیں بھی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mọi tệp, cho bất kỳ ai, ở bất cứ đâu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "任何文件，发给任何人，送到任何地方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "任何檔案，傳給任何人，送到任何地方。"
          }
        }
      }
    },
