    "setupBackgroundBatteryHint": {
      "comment": "The same page: under the first button, which opens TotalDrop's app info; what to do there",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "في صفحة معلومات تطبيق TotalDrop، افتح «البطارية» واسمح بالاستخدام دون قيود. تختلف أسماء هذه الإعدادات من هاتف إلى آخر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop-এর অ্যাপ তথ্য পৃষ্ঠায় \"ব্যাটারি\" খুলে সীমাহীন ব্যবহারের অনুমতি দিন। এই সেটিংসের নাম ফোনভেদে আলাদা হয়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Na stránce informací o aplikaci TotalDrop otevřete Baterii a povolte neomezené používání. Názvy těchto nastavení se v různých telefonech liší."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Åbn Batteri på TotalDrops appinfoside, og tillad ubegrænset brug. Navnene på disse indstillinger varierer fra telefon til telefon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Öffnen Sie in den App-Infos von TotalDrop „Akku“ und erlauben Sie die uneingeschränkte Nutzung. Die Namen dieser Einstellungen sind je nach Telefon verschieden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Στη σελίδα πληροφοριών εφαρμογής του TotalDrop, ανοίξτε «Μπαταρία» και επιτρέψτε τη χρήση χωρίς περιορισμούς. Τα ονόματα αυτών των ρυθμίσεων διαφέρουν από τηλέφωνο σε τηλέφωνο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On TotalDrop's app info page, open Battery and allow unrestricted use. The names of these settings differ from phone to phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En la información de la aplicación TotalDrop, abra «Batería» y permita el uso sin restricciones. Los nombres de estos ajustes cambian de un teléfono a otro."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "در صفحهٔ اطلاعات برنامهٔ TotalDrop، «باتری» را باز کنید و استفادهٔ بدون محدودیت را مجاز کنید. نام این تنظیمات از گوشی به گوشی فرق دارد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Avaa TotalDropin sovellustiedoista Akku ja salli rajoittamaton käyttö. Näiden asetusten nimet vaihtelevat puhelimittain."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dans les infos de l'application TotalDrop, ouvrez « Batterie » et autorisez l'utilisation sans restriction. Le nom de ces réglages varie d'un téléphone à l'autre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "בדף פרטי האפליקציה של TotalDrop, פתחו את „סוללה” ואפשרו שימוש ללא הגבלה. שמות ההגדרות האלה משתנים מטלפון לטלפון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop के ऐप जानकारी पेज पर \"बैटरी\" खोलें और बिना रोक-टोक इस्तेमाल की अनुमति दें। इन सेटिंग के नाम हर फ़ोन में अलग होते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A TotalDrop alkalmazásinformációinál nyissa meg az Akkumulátor részt, és engedélyezze a korlátlan használatot. A beállítások neve telefononként eltér."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Di halaman info aplikasi TotalDrop, buka Baterai dan izinkan penggunaan tanpa batasan. Nama setelan ini berbeda di setiap ponsel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nelle informazioni dell'app TotalDrop, apri Batteria e consenti l'uso senza limitazioni. I nomi di queste impostazioni cambiano da telefono a telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop のアプリ情報で「バッテリー」を開き、制限なしの使用を許可してください。設定の名前は端末によって異なります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop의 앱 정보에서 배터리를 열고 제한 없는 사용을 허용하세요. 이 설정의 이름은 휴대전화마다 다릅니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pada halaman maklumat apl TotalDrop, buka Bateri dan benarkan penggunaan tanpa had. Nama tetapan ini berbeza antara telefon."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Åpne Batteri på appinfosiden til TotalDrop, og tillat ubegrenset bruk. Navnene på disse innstillingene varierer fra telefon til telefon."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Open op de app-infopagina van TotalDrop Batterij en sta onbeperkt gebruik toe. De namen van deze instellingen verschillen per telefoon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Na stronie informacji o aplikacji TotalDrop otwórz Bateria i zezwól na użycie bez ograniczeń. Nazwy tych ustawień różnią się w zależności od telefonu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Na página de informações do app TotalDrop, abra Bateria e permita o uso sem restrições. Os nomes dessas configurações mudam de um celular para outro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Na página de informações da aplicação TotalDrop, abra Bateria e permita a utilização sem restrições. Os nomes destas definições variam de telemóvel para telemóvel."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "În pagina de informații despre aplicația TotalDrop, deschideți Baterie și permiteți utilizarea fără restricții. Numele acestor setări diferă de la un telefon la altul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "На странице сведений о приложении TotalDrop откройте «Батарея» и разрешите работу без ограничений. Названия этих настроек на разных телефонах отличаются."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Öppna Batteri på TotalDrops appinfosida och tillåt obegränsad användning. Namnen på de här inställningarna skiljer sig mellan telefoner."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kwenye ukurasa wa maelezo ya programu ya TotalDrop, fungua Betri na uruhusu matumizi bila vikwazo. Majina ya mipangilio hii hutofautiana kati ya simu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ในหน้าข้อมูลแอปของ TotalDrop ให้เปิด \"แบตเตอรี่\" แล้วอนุญาตให้ใช้งานแบบไม่จำกัด ชื่อการตั้งค่าเหล่านี้ต่างกันไปในแต่ละโทรศัพท์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TotalDrop'un uygulama bilgileri sayfasında Pil'i açın ve kısıtlamasız kullanıma izin verin. Bu ayarların adları telefondan telefona değişir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "На сторінці інформації про застосунок TotalDrop відкрийте «Батарея» й дозвольте роботу без обмежень. Назви цих налаштувань на різних телефонах різні."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop کے ایپ کی معلومات والے صفحے پر \"بیٹری\" کھولیں اور بغیر پابندی استعمال کی اجازت دیں۔ ان ترتیبات کے نام ہر فون میں مختلف ہوتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trong trang thông tin ứng dụng TotalDrop, mở Pin và cho phép sử dụng không hạn chế. Tên các cài đặt này khác nhau tùy điện thoại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在 TotalDrop 的应用信息页面中打开“电池”，并允许无限制使用。这些设置的名称因手机而异。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在 TotalDrop 的應用程式資訊頁面中開啟「電池」，並允許無限制使用。這些設定的名稱因手機而異。"
          }
        }
      }
    },
    "setupBackgroundBody": {
      "comment": "The same page: why TotalDrop asks to run without battery restrictions",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لكي يستمر النقل عند التبديل إلى تطبيق آخر أو قفل الشاشة، اسمح لـ TotalDrop بالعمل بلا قيود على البطارية. لا يعمل TotalDrop في الخلفية إلا أثناء نقل بدأته أنت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "অন্য অ্যাপে গেলে বা স্ক্রিন লক করলেও যাতে ট্রান্সফার চলতে থাকে, সেজন্য TotalDrop-কে ব্যাটারির বিধিনিষেধ ছাড়া চলতে দিন। আপনার শুরু করা কোনো ট্রান্সফার চলার সময়েই কেবল TotalDrop ব্যাকগ্রাউন্ডে কাজ করে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aby přenos pokračoval i po přepnutí do jiné aplikace nebo zamknutí obrazovky, povolte TotalDropu běžet bez omezení baterie. TotalDrop pracuje na pozadí jen během přenosu, který jste sami spustili."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "For at en overførsel fortsætter, når du skifter app eller låser skærmen, skal TotalDrop have lov til at køre uden batteribegrænsninger. TotalDrop arbejder kun i baggrunden, mens en overførsel, du har startet, kører."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Damit eine Übertragung weiterläuft, wenn Sie die App wechseln oder den Bildschirm sperren, erlauben Sie TotalDrop, ohne Akkubeschränkungen zu laufen. TotalDrop arbeitet im Hintergrund nur, solange eine von Ihnen gestartete Übertragung läuft."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Για να συνεχίζει μια μεταφορά όταν αλλάζετε εφαρμογή ή κλειδώνετε την οθόνη, επιτρέψτε στο TotalDrop να εκτελείται χωρίς περιορισμούς μπαταρίας. Το TotalDrop λειτουργεί στο παρασκήνιο μόνο όσο τρέχει μια μεταφορά που ξεκινήσατε εσείς."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So that a transfer keeps going when you switch apps or lock the screen, let TotalDrop run without battery restrictions. TotalDrop works in the background only while a transfer you started is running."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Para que una transferencia continúe cuando cambie de app o bloquee la pantalla, permita que TotalDrop funcione sin restricciones de batería. TotalDrop solo trabaja en segundo plano mientras dura una transferencia que usted inició."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "برای اینکه انتقال هنگام رفتن به برنامه دیگر یا قفل کردن صفحه ادامه پیدا کند، اجازه دهید TotalDrop بدون محدودیت باتری اجرا شود. TotalDrop فقط هنگامی در پس‌زمینه کار می‌کند که انتقالی که خودتان شروع کرده‌اید در جریان باشد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jotta siirto jatkuu, kun vaihdat sovellusta tai lukitset näytön, salli TotalDropin toimia ilman akkurajoituksia. TotalDrop toimii taustalla vain, kun itse aloittamasi siirto on käynnissä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pour qu'un transfert continue quand vous changez d'appli ou verrouillez l'écran, autorisez TotalDrop à fonctionner sans restriction de batterie. TotalDrop ne travaille en arrière-plan que pendant un transfert que vous avez lancé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "כדי שהעברה תמשיך כשעוברים לאפליקציה אחרת או נועלים את המסך, אפשרו ל־TotalDrop לפעול בלי הגבלות סוללה. TotalDrop פועל ברקע רק בזמן העברה שהתחלתם בעצמכם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ऐप बदलने या स्क्रीन लॉक करने पर भी ट्रांसफ़र चलता रहे, इसके लिए TotalDrop को बिना बैटरी प्रतिबंध के चलने दें। TotalDrop बैकग्राउंड में केवल तभी काम करता है जब आपका शुरू किया हुआ ट्रांसफ़र चल रहा हो।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hogy az átvitel akkor is folytatódjon, amikor másik alkalmazásra vált vagy lezárja a képernyőt, engedje, hogy a TotalDrop akkumulátorkorlátozás nélkül fusson. A TotalDrop csak egy Ön által indított átvitel közben dolgozik a háttérben."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Agar transfer tetap berjalan saat Anda berpindah aplikasi atau mengunci layar, izinkan TotalDrop berjalan tanpa batasan baterai. TotalDrop hanya bekerja di latar belakang selama transfer yang Anda mulai sedang berjalan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Perché un trasferimento continui quando cambi app o blocchi lo schermo, consenti a TotalDrop di funzionare senza restrizioni della batteria. TotalDrop lavora in background solo mentre è in corso un trasferimento che hai avviato tu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "アプリを切り替えたり画面をロックしたりしても転送が続くように、TotalDrop をバッテリーの制限なしで動かせるようにしてください。TotalDrop がバックグラウンドで動くのは、あなたが始めた転送の間だけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "다른 앱으로 전환하거나 화면을 잠가도 전송이 계속되도록 TotalDrop이 배터리 제한 없이 실행되게 허용하세요. TotalDrop은 내가 시작한 전송이 진행되는 동안에만 백그라운드에서 작동합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Supaya pemindahan diteruskan apabila anda menukar apl atau mengunci skrin, benarkan TotalDrop berjalan tanpa sekatan bateri. TotalDrop hanya berfungsi di latar belakang semasa pemindahan yang anda mulakan sedang berjalan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "For at en overføring skal fortsette når du bytter app eller låser skjermen, la TotalDrop kjøre uten batteribegrensninger. TotalDrop jobber bare i bakgrunnen mens en overføring du har startet, pågår."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zodat een overdracht doorgaat als je van app wisselt of het scherm vergrendelt, laat je TotalDrop zonder batterijbeperkingen werken. TotalDrop werkt alleen op de achtergrond zolang een overdracht loopt die jij hebt gestart."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aby przesyłanie trwało po przełączeniu aplikacji lub zablokowaniu ekranu, pozwól TotalDropowi działać bez ograniczeń baterii. TotalDrop działa w tle tylko wtedy, gdy trwa przesyłanie, które sam rozpocząłeś."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Para que uma transferência continue quando você troca de app ou bloqueia a tela, permita que o TotalDrop funcione sem restrições de bateria. O TotalDrop só trabalha em segundo plano enquanto uma transferência iniciada por você está em andamento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Para que uma transferência continue quando muda de app ou bloqueia o ecrã, permita que o TotalDrop funcione sem restrições de bateria. O TotalDrop só trabalha em segundo plano enquanto decorre uma transferência que iniciou."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pentru ca un transfer să continue când schimbați aplicația sau blocați ecranul, permiteți TotalDrop să ruleze fără restricții de baterie. TotalDrop lucrează în fundal doar cât timp rulează un transfer pornit de dvs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Чтобы передача продолжалась, когда вы переключаетесь на другое приложение или блокируете экран, разрешите TotalDrop работать без ограничений батареи. TotalDrop работает в фоне только во время передачи, которую вы начали сами."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "För att en överföring ska fortsätta när du byter app eller låser skärmen, låt TotalDrop köras utan batteribegränsningar. TotalDrop arbetar bara i bakgrunden medan en överföring som du har startat pågår."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ili uhamisho uendelee unapobadilisha programu au kufunga skrini, ruhusu TotalDrop ifanye kazi bila vikwazo vya betri. TotalDrop hufanya kazi chinichini tu wakati uhamisho ulioanzisha wewe unaendelea."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เพื่อให้การโอนทำงานต่อเมื่อคุณสลับแอปหรือล็อกหน้าจอ ให้ TotalDrop ทำงานได้โดยไม่มีข้อจำกัดด้านแบตเตอรี่ TotalDrop ทำงานในเบื้องหลังเฉพาะขณะที่การโอนที่คุณเริ่มเองกำลังดำเนินอยู่เท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama değiştirdiğinizde ya da ekranı kilitlediğinizde aktarımın sürmesi için TotalDrop'un pil kısıtlaması olmadan çalışmasına izin verin. TotalDrop arka planda yalnızca sizin başlattığınız bir aktarım sürerken çalışır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Щоб передавання тривало, коли ви перемикаєтеся на іншу програму чи блокуєте екран, дозвольте TotalDrop працювати без обмежень батареї. TotalDrop працює у фоні лише під час передавання, яке ви почали самі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ایپ بدلنے یا اسکرین لاک کرنے پر بھی منتقلی جاری رہے، اس کے لیے TotalDrop کو بیٹری کی پابندیوں کے بغیر چلنے دیں۔ TotalDrop پس منظر میں صرف اسی وقت کام کرتا ہے جب آپ کی شروع کی ہوئی منتقلی جاری ہو۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Để quá trình truyền tiếp tục khi bạn chuyển ứng dụng hoặc khóa màn hình, hãy cho phép TotalDrop chạy không bị giới hạn pin. TotalDrop chỉ hoạt động ở chế độ nền khi một lượt truyền do bạn bắt đầu đang chạy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "为了在切换应用或锁定屏幕时传输仍能继续，请允许 TotalDrop 不受电池限制地运行。TotalDrop 只在您发起的传输进行时才在后台工作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "為了在切換應用程式或鎖定螢幕時傳輸仍能繼續，請允許 TotalDrop 不受電池限制地執行。TotalDrop 只在您發起的傳輸進行時才在背景運作。"
          }
        }
      }
    },
