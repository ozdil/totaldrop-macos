    "technicalDetail": {
      "comment": "Under Details, above the error's technical text, which stays in English so it can be searched and reported",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "رسالة تقنية بالإنجليزية، لإرفاقها عند الإبلاغ عن مشكلة:"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ইংরেজিতে প্রযুক্তিগত বার্তা, সমস্যা জানানোর সময় যোগ করার জন্য:"
