    "setupBackgroundMakerBody": {
      "comment": "The same page: what to choose in the maker's battery saver; \"No restrictions\" is the label on Xiaomi phones, use the label those phones show in your language",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "افتح أيضًا موفّر البطارية الخاص بـ TotalDrop واختر \"بلا قيود\". وإن كان في الهاتف خيار التشغيل التلقائي، ففعّله لـ TotalDrop."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop-এর ব্যাটারি সেভারও খুলে \"কোনো বিধিনিষেধ নেই\" বেছে নিন। ফোনে অটোস্টার্ট থাকলে TotalDrop-এর জন্য তা চালু করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otevřete také spořič baterie pro TotalDrop a zvolte „Bez omezení“. Pokud telefon nabízí Automatické spuštění, zapněte ho pro TotalDrop."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Åbn også TotalDrops batterisparer, og vælg \"Ingen begrænsninger\". Hvis telefonen har Autostart, så slå det til for TotalDrop."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Öffnen Sie auch den Energiesparmodus für TotalDrop und wählen Sie „Keine Einschränkungen“. Hat das Telefon Autostart, schalten Sie es für TotalDrop ein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ανοίξτε επίσης την εξοικονόμηση μπαταρίας του TotalDrop και επιλέξτε «Χωρίς περιορισμούς». Αν το τηλέφωνο έχει Αυτόματη εκκίνηση, ενεργοποιήστε την για το TotalDrop."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open TotalDrop's battery saver too and choose \"No restrictions\". If the phone has Autostart, turn it on for TotalDrop."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abra también el ahorro de batería de TotalDrop y elija \"Sin restricciones\". Si el teléfono tiene Inicio automático, actívelo para TotalDrop."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "صرفه‌جوی باتری TotalDrop را هم باز کنید و «بدون محدودیت» را انتخاب کنید. اگر گوشی شروع خودکار دارد، آن را برای TotalDrop روشن کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Avaa myös TotalDropin virransäästö ja valitse ”Ei rajoituksia”. Jos puhelimessa on Automaattinen käynnistys, ota se käyttöön TotalDropille."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ouvrez aussi l'économiseur de batterie de TotalDrop et choisissez « Aucune restriction ». Si le téléphone propose le Démarrage automatique, activez-le pour TotalDrop."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "פתחו גם את חיסכון הסוללה של TotalDrop ובחרו \"ללא הגבלות\". אם בטלפון יש הפעלה אוטומטית, הפעילו אותה עבור TotalDrop."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop का बैटरी सेवर भी खोलें और \"कोई प्रतिबंध नहीं\" चुनें। फ़ोन में ऑटोस्टार्ट हो तो उसे TotalDrop के लिए चालू करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nyissa meg a TotalDrop akkumulátorkímélőjét is, és válassza a „Nincs korlátozás” lehetőséget. Ha a telefonon van Automatikus indítás, kapcsolja be a TotalDrophoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Buka juga penghemat baterai TotalDrop dan pilih \"Tanpa batasan\". Jika ponsel punya Mulai otomatis, aktifkan untuk TotalDrop."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apri anche il risparmio batteria di TotalDrop e scegli \"Nessuna restrizione\". Se il telefono ha l'Avvio automatico, attivalo per TotalDrop."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop のバッテリーセーバーも開き、「制限なし」を選んでください。自動起動がある場合は、TotalDrop で有効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop의 배터리 절약도 열어 '제한 없음'을 선택하세요. 자동 시작이 있으면 TotalDrop에 대해 켜세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Buka juga penjimat bateri TotalDrop dan pilih \"Tiada sekatan\". Jika telefon mempunyai Automula, hidupkannya untuk TotalDrop."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Åpne også TotalDrops batterisparing og velg «Ingen begrensninger». Hvis telefonen har Autostart, slår du det på for TotalDrop."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Open ook de batterijbesparing van TotalDrop en kies 'Geen beperkingen'. Heeft de telefoon Autostart, zet het dan aan voor TotalDrop."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otwórz też oszczędzanie baterii dla TotalDropa i wybierz „Bez ograniczeń”. Jeśli telefon ma Autostart, włącz go dla TotalDropa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abra também a economia de bateria do TotalDrop e escolha \"Sem restrições\". Se o celular tiver Início automático, ative-o para o TotalDrop."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abra também a poupança de bateria do TotalDrop e escolha \"Sem restrições\". Se o telemóvel tiver Arranque automático, ative-o para o TotalDrop."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deschideți și economizorul de baterie al TotalDrop și alegeți „Fără restricții”. Dacă telefonul are Pornire automată, activați-o pentru TotalDrop."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Откройте также экономию заряда для TotalDrop и выберите «Нет ограничений». Если на телефоне есть автозапуск, включите его для TotalDrop."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Öppna även TotalDrops batterisparfunktion och välj ”Inga begränsningar”. Om telefonen har Autostart, slå på det för TotalDrop."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fungua pia kiokoa betri cha TotalDrop na uchague \"Hakuna vikwazo\". Ikiwa simu ina Kuanza kiotomatiki, kiwashe kwa TotalDrop."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เปิดโหมดประหยัดแบตเตอรี่ของ TotalDrop ด้วยแล้วเลือก \"ไม่จำกัด\" หากโทรศัพท์มีการเริ่มอัตโนมัติ ให้เปิดสำหรับ TotalDrop"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TotalDrop'un pil tasarrufunu da açıp \"Kısıtlama yok\"u seçin. Telefonda Otomatik başlatma varsa TotalDrop için açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Відкрийте також енергозбереження для TotalDrop і виберіть «Без обмежень». Якщо на телефоні є автозапуск, увімкніть його для TotalDrop."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TotalDrop کا بیٹری سیور بھی کھولیں اور \"کوئی پابندی نہیں\" منتخب کریں۔ اگر فون میں آٹو اسٹارٹ ہو تو اسے TotalDrop کے لیے آن کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hãy mở cả trình tiết kiệm pin của TotalDrop và chọn \"Không hạn chế\". Nếu điện thoại có Tự khởi động, hãy bật cho TotalDrop."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请同时打开 TotalDrop 的省电策略并选择“无限制”。如果手机有自启动，请为 TotalDrop 开启。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "請同時開啟 TotalDrop 的省電設定並選擇「無限制」。如果手機有自動啟動，請為 TotalDrop 開啟。"
          }
        }
      }
    },
