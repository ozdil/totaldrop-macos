    "settingsWordsEnglish": {
      "comment": "Shown in Settings under About. Explains why the transfer code and the verification words stay in English: they come from one English word list so that both devices show the same ones",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تبقى الرموز وكلمات التحقق بالإنجليزية في كل اللغات، حتى يعرض جهازان بلغتين مختلفتين الكلمات نفسها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "কোড ও যাচাইয়ের শব্দ সব ভাষাতেই ইংরেজিতে থাকে, যাতে ভিন্ন ভাষার দুটি ডিভাইস একই শব্দ দেখায়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kódy a ověřovací slova jsou v každém jazyce v angličtině, aby dvě zařízení v různých jazycích zobrazovala stejná slova."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Koder og bekræftelsesord er altid på engelsk, så to enheder på forskellige sprog viser de samme ord."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Codes und Prüfwörter sind in jeder Sprache auf Englisch, damit zwei Geräte mit unterschiedlicher Sprache dieselben Wörter anzeigen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Οι κωδικοί και οι λέξεις επαλήθευσης είναι πάντα στα αγγλικά, ώστε δύο συσκευές σε διαφορετικές γλώσσες να δείχνουν τις ίδιες λέξεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Codes and verification words are in English in every language, so two devices set to different languages show the same words."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los códigos y las palabras de verificación están siempre en inglés, para que dos dispositivos en idiomas distintos muestren las mismas palabras."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "کدها و کلمات تأیید در همه زبان‌ها انگلیسی می‌مانند تا دو دستگاه با زبان‌های متفاوت همان کلمات را نشان دهند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Koodit ja tarkistussanat ovat aina englanniksi, jotta eri kielille asetetut laitteet näyttävät samat sanat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les codes et les mots de vérification restent en anglais dans toutes les langues, pour que deux appareils réglés dans des langues différentes affichent les mêmes mots."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "קודים ומילות אימות נשארים באנגלית בכל שפה, כדי ששני מכשירים בשפות שונות יציגו את אותן מילים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कोड और सत्यापन शब्द हर भाषा में अंग्रेज़ी में रहते हैं, ताकि अलग-अलग भाषाओं वाले दो डिवाइस एक जैसे शब्द दिखाएँ।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A kódok és az ellenőrző szavak minden nyelven angolul jelennek meg, hogy a különböző nyelvű eszközök ugyanazokat a szavakat mutassák."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kode dan kata verifikasi selalu dalam bahasa Inggris, agar dua perangkat dengan bahasa berbeda menampilkan kata yang sama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I codici e le parole di verifica restano in inglese in ogni lingua, così due dispositivi impostati su lingue diverse mostrano le stesse parole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "コードと確認用の単語はどの言語でも英語のままです。言語の異なるデバイス同士でも同じ単語が表示されるようにするためです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "코드와 확인 단어는 어떤 언어에서도 영어로 표시됩니다. 언어가 다른 두 기기에서도 같은 단어가 보입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kod dan perkataan pengesahan sentiasa dalam bahasa Inggeris, supaya dua peranti dalam bahasa berbeza menunjukkan perkataan yang sama."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Koder og bekreftelsesord er alltid på engelsk, slik at to enheter med ulike språk viser de samme ordene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Codes en verificatiewoorden zijn in elke taal Engels, zodat twee apparaten in verschillende talen dezelfde woorden tonen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kody i słowa weryfikacyjne są zawsze po angielsku, aby dwa urządzenia w różnych językach pokazywały te same słowa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Códigos e palavras de verificação ficam sempre em inglês, para que dois dispositivos em idiomas diferentes mostrem as mesmas palavras."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os códigos e as palavras de verificação estão sempre em inglês, para que dois dispositivos em idiomas diferentes mostrem as mesmas palavras."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Codurile și cuvintele de verificare sunt mereu în engleză, ca două dispozitive în limbi diferite să arate aceleași cuvinte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Коды и проверочные слова всегда на английском, чтобы два устройства с разными языками показывали одинаковые слова."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Koder och verifieringsord är alltid på engelska, så att två enheter med olika språk visar samma ord."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Misimbo na maneno ya uthibitisho huwa kwa Kiingereza katika kila lugha, ili vifaa viwili vyenye lugha tofauti vionyeshe maneno yale yale."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "รหัสและคำยืนยันเป็นภาษาอังกฤษในทุกภาษา เพื่อให้อุปกรณ์สองเครื่องที่ใช้ภาษาต่างกันแสดงคำเดียวกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodlar ve doğrulama kelimeleri her dilde İngilizcedir; böylece farklı dillere ayarlı iki cihaz aynı kelimeleri gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Коди та слова перевірки завжди англійською, щоб два пристрої з різними мовами показували однакові слова."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "کوڈ اور تصدیقی الفاظ ہر زبان میں انگریزی میں رہتے ہیں، تاکہ مختلف زبانوں والے دو آلات ایک جیسے الفاظ دکھائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mã và từ xác minh luôn bằng tiếng Anh, để hai thiết bị dùng ngôn ngữ khác nhau hiển thị các từ giống nhau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "代码和验证词在任何语言下都使用英文，这样两台语言不同的设备会显示相同的单词。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "代碼和驗證單字在任何語言下都使用英文，這樣兩部語言不同的裝置會顯示相同的單字。"
          }
        }
      }
    },
