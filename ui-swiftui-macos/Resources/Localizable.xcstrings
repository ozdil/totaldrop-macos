          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "فائلیں براہِ راست دوسرے آلے پر بھیجیں، اینڈ ٹو اینڈ انکرپٹڈ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gửi tệp thẳng tới thiết bị khác, mã hóa đầu cuối"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "将文件直接发送到另一台设备，端到端加密"
