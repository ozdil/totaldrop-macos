    "sendCodeHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "على الجهاز الآخر، افتح TotalDrop واضغط على استلام وأدخل هذا الرمز."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "অন্য ডিভাইসে TotalDrop খুলুন, গ্রহণ করুন-এ ট্যাপ করুন আর এই কোডটি লিখুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Na druhém zařízení otevřete TotalDrop, klepněte na Přijmout a zadejte tento kód."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Åbn TotalDrop på den anden enhed, tryk på Modtag, og indtast denne kode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Öffnen Sie auf dem anderen Gerät TotalDrop, tippen Sie auf Empfangen und geben Sie diesen Code ein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Στην άλλη συσκευή, ανοίξτε το TotalDrop, πατήστε Λήψη και εισαγάγετε αυτόν τον κωδικό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the other device, open TotalDrop, tap Receive and enter this code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En el otro dispositivo, abre TotalDrop, toca Recibir e introduce este código."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "در دستگاه دیگر، TotalDrop را باز کنید، روی دریافت بزنید و این کد را وارد کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Avaa toisella laitteella TotalDrop, napauta Vastaanota ja anna tämä koodi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sur l'autre appareil, ouvrez TotalDrop, appuyez sur Recevoir et saisissez ce code."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
