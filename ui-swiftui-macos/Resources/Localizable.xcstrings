    "cancelTransferBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "سيتم إبلاغ الطرف الآخر بأن النقل توقف."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "অন্য পক্ষকে জানানো হবে যে ট্রান্সফার থেমে গেছে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Druhá strana se dozví, že byl přenos zastaven."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Den anden side får besked om, at overførslen blev stoppet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Gegenseite erfährt, dass die Übertragung beendet wurde."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Η άλλη πλευρά θα ενημερωθεί ότι η μεταφορά διακόπηκε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The other side will be told the transfer stopped."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se avisará a la otra parte de que la transferencia se detuvo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "به طرف مقابل اطلاع داده می‌شود که انتقال متوقف شد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toiselle osapuolelle kerrotaan, että siirto lopetettiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L'autre appareil sera informé de l'arrêt du transfert."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הצד השני יקבל הודעה שההעברה נעצרה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "दूसरी तरफ़ बताया जाएगा कि ट्रांसफ़र रुक गया।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A másik fél értesítést kap, hogy az átvitel leállt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pihak lain akan diberi tahu bahwa transfer dihentikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L'altra parte verrà avvisata che il trasferimento è stato interrotto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "転送を中止したことが相手に通知されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "상대방에게 전송이 중단되었다고 알립니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pihak satu lagi akan dimaklumkan bahawa pemindahan telah dihentikan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Den andre siden får beskjed om at overføringen ble stoppet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De andere kant krijgt te horen dat de overdracht is gestopt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Druga strona zostanie powiadomiona, że transfer został zatrzymany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O outro lado será avisado de que a transferência parou."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O outro lado será informado de que a transferência parou."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cealaltă parte va fi anunțată că transferul s-a oprit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Другой стороне сообщат, что передача остановлена."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Den andra sidan får veta att överföringen stoppades."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Upande mwingine utaarifiwa kuwa uhamishaji umesimamishwa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "อีกฝ่ายจะได้รับแจ้งว่าการโอนหยุดแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karşı tarafa gönderimin durduğu bildirilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Іншій стороні повідомлять, що передачу зупинено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "دوسری طرف کو بتا دیا جائے گا کہ منتقلی روک دی گئی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bên kia sẽ được thông báo rằng việc truyền đã dừng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "对方会收到传输已停止的通知。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "對方會收到傳輸已停止的通知。"
          }
        }
      }
    },
    "cancelTransferTitle": {
