          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tuma faili moja kwa moja kwenye kifaa kingine, zimesimbwa mwanzo hadi mwisho"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ส่งไฟล์ตรงไปยังอุปกรณ์อื่น เข้ารหัสตั้งแต่ต้นทางถึงปลายทาง"
