    "privacyModeHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "وضع الخصوصية: يمر كل شيء عبر خادم الترحيل، فلا يعرف الجهاز الآخر عنوان IP الخاص بك أبدًا. النقل أبطأ، ويجب أن يستخدم الجهاز الآخر خادم الترحيل نفسه (الخادم الافتراضي يفي بذلك)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "গোপনীয়তা মোড: সবকিছু রিলে সার্ভারের মধ্য দিয়ে যায়, তাই অন্য ডিভাইস কখনও আপনার IP ঠিকানা জানতে পারে না। এটি ধীর, আর অন্য ডিভাইসকেও একই রিলে সার্ভার ব্যবহার করতে হবে (ডিফল্ট সার্ভার তাই করে)।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Režim soukromí: vše jde přes zprostředkující server, takže druhé zařízení se vaši IP adresu nikdy nedozví. Je to pomalejší a druhé zařízení musí používat stejný zprostředkující server (výchozí to splňuje)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Privatlivstilstand: alt går gennem relæserveren, så den anden enhed aldrig får din IP-adresse at vide. Langsommere, og den anden enhed skal bruge samme relæserver (det gør standardserveren)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Privatsphäre-Modus: Alles läuft über den Relay-Server, sodass das andere Gerät Ihre IP-Adresse nie erfährt. Langsamer, und das andere Gerät muss denselben Relay-Server verwenden (beim Standardserver ist das so)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Λειτουργία απορρήτου: όλα περνούν από τον διακομιστή αναμετάδοσης, ώστε η άλλη συσκευή να μη μάθει ποτέ τη διεύθυνση IP σας. Πιο αργό, και η άλλη συσκευή πρέπει να χρησιμοποιεί τον ίδιο διακομιστή αναμετάδοσης (ο προεπιλεγμένος το κάνει)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy mode: everything goes through the relay, so the other device never learns your IP address. Slower, and the other device must use the same relay (the default one does)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Modo privacidad: todo pasa por el servidor de retransmisión, así que el otro dispositivo nunca conoce tu dirección IP. Es más lento, y el otro dispositivo debe usar el mismo servidor de retransmisión (el predeterminado lo hace)."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "حالت حریم خصوصی: همه چیز از سرور رله می‌گذرد، بنابراین دستگاه دیگر هرگز نشانی IP شما را نمی‌فهمد. کندتر است و دستگاه دیگر باید از همان سرور رله استفاده کند (سرور پیش‌فرض همین است)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yksityisyystila: kaikki kulkee välityspalvelimen kautta, joten toinen laite ei koskaan saa tietää IP-osoitettasi. Hitaampi, ja toisen laitteen on käytettävä samaa välityspalvelinta (oletuspalvelin käyttää)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mode confidentialité : tout passe par le serveur relais, si bien que l'autre appareil ne connaît jamais votre adresse IP. Plus lent, et l'autre appareil doit utiliser le même serveur relais (c'est le cas de celui par défaut)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "מצב פרטיות: הכול עובר דרך שרת הממסר, כך שהמכשיר השני לעולם לא יודע את כתובת ה־IP שלך. איטי יותר, והמכשיר השני חייב להשתמש באותו שרת ממסר (שרת ברירת המחדל עונה על כך)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "निजता मोड: सब कुछ रिले सर्वर से होकर जाता है, इसलिए दूसरे डिवाइस को आपका IP पता कभी पता नहीं चलता। यह धीमा है, और दूसरे डिवाइस को भी वही रिले सर्वर इस्तेमाल करना होगा (डिफ़ॉल्ट सर्वर यही करता है)।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Adatvédelmi mód: minden a továbbító szerveren megy át, így a másik eszköz sosem tudja meg az IP-címedet. Lassabb, és a másik eszköznek ugyanazt a továbbító szervert kell használnia (az alapértelmezett ilyen)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mode privasi: semuanya melewati server relai, jadi perangkat lain tidak pernah mengetahui alamat IP Anda. Lebih lambat, dan perangkat lain harus menggunakan relai yang sama (relai default memenuhinya)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Modalità privacy: tutto passa dal server di inoltro, così l'altro dispositivo non conosce mai il tuo indirizzo IP. È più lenta, e l'altro dispositivo deve usare lo stesso server di inoltro (quello predefinito lo fa)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "プライバシーモード：すべてがリレーを経由するため、相手のデバイスにあなたの IP アドレスが知られることはありません。速度は遅くなり、相手のデバイスも同じリレーを使う必要があります（デフォルトのリレーなら同じです）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "개인정보 보호 모드: 모든 전송이 릴레이를 거치므로 상대 기기는 내 IP 주소를 알 수 없습니다. 속도가 느려지며, 상대 기기도 같은 릴레이를 사용해야 합니다(기본 릴레이는 같습니다)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mod privasi: semuanya melalui pelayan geganti, jadi peranti lain tidak pernah mengetahui alamat IP anda. Lebih perlahan, dan peranti lain mesti menggunakan geganti yang sama (geganti lalai memenuhinya)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Personvernmodus: alt går gjennom reléserveren, så den andre enheten får aldri vite IP-adressen din. Tregere, og den andre enheten må bruke samme reléserver (standardserveren gjør det)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Privacymodus: alles gaat via de relayserver, zodat het andere apparaat je IP-adres nooit te weten komt. Langzamer, en het andere apparaat moet dezelfde relayserver gebruiken (de standaardserver doet dat)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tryb prywatności: wszystko przechodzi przez serwer pośredniczący, więc drugie urządzenie nigdy nie pozna twojego adresu IP. Działa wolniej, a drugie urządzenie musi używać tego samego serwera pośredniczącego (domyślny to zapewnia)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Modo de privacidade: tudo passa pelo servidor de retransmissão, então o outro dispositivo nunca descobre seu endereço IP. É mais lento, e o outro dispositivo precisa usar o mesmo servidor de retransmissão (o padrão usa)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Modo de privacidade: tudo passa pelo servidor de retransmissão, pelo que o outro dispositivo nunca fica a saber o seu endereço IP. É mais lento, e o outro dispositivo tem de usar o mesmo servidor de retransmissão (o predefinido usa)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Modul de confidențialitate: totul trece prin serverul releu, așa că celălalt dispozitiv nu vă află niciodată adresa IP. Este mai lent, iar celălalt dispozitiv trebuie să folosească același server releu (cel implicit o face)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Режим конфиденциальности: всё идёт через ретранслятор, поэтому другое устройство никогда не узнает ваш IP-адрес. Это медленнее, и другое устройство должно использовать тот же ретранслятор (стандартный подходит)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Integritetsläge: allt går via reläservern, så den andra enheten får aldrig veta din IP-adress. Långsammare, och den andra enheten måste använda samma reläserver (standardservern gör det)."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hali ya faragha: kila kitu hupita kupitia seva ya kati, kwa hiyo kifaa kingine hakijui kamwe anwani yako ya IP. Ni polepole zaidi, na kifaa kingine lazima kitumie seva ya kati ile ile (ile ya chaguomsingi inafaa)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "โหมดความเป็นส่วนตัว: ทุกอย่างผ่านเซิร์ฟเวอร์รีเลย์ อุปกรณ์อีกเครื่องจึงไม่มีทางรู้ที่อยู่ IP ของคุณ ช้ากว่า และอุปกรณ์อีกเครื่องต้องใช้รีเลย์เดียวกัน (รีเลย์เริ่มต้นใช้ได้)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizlilik modu: tüm aktarımlar aktarma sunucusu üzerinden geçer, böylece karşı cihaz IP adresinizi hiç öğrenmez. Daha yavaştır ve karşı cihazın da aynı aktarma sunucusunu kullanması gerekir (varsayılan sunucu aynıdır)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Режим конфіденційності: усе йде через ретранслятор, тож інший пристрій ніколи не дізнається вашої IP-адреси. Це повільніше, і інший пристрій має використовувати той самий ретранслятор (типовий підходить)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "رازداری موڈ: سب کچھ ریلے سے گزرتا ہے، اس لیے دوسرے آلے کو کبھی آپ کا IP پتہ معلوم نہیں ہوتا۔ یہ سست ہے، اور دوسرے آلے کو بھی وہی ریلے استعمال کرنا ہوگا (ڈیفالٹ ریلے یہی کرتا ہے)۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chế độ riêng tư: mọi thứ đi qua máy chủ chuyển tiếp, nên thiết bị kia không bao giờ biết địa chỉ IP của bạn. Chậm hơn, và thiết bị kia phải dùng cùng máy chủ chuyển tiếp (máy chủ mặc định đáp ứng điều này)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "隐私模式：所有数据都经由中继服务器，对方设备永远不会知道你的 IP 地址。速度较慢，且对方设备必须使用同一个中继服务器（默认的中继服务器即可）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "隱私模式：所有資料都經由中繼伺服器，對方裝置永遠不會知道你的 IP 位址。速度較慢，且對方裝置必須使用同一個中繼伺服器（預設的中繼伺服器即可）。"
          }
        }
      }
    },
